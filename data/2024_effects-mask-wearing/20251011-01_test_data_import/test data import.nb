         RowBox[{"[", 
          RowBox[{"All", ",", "All", ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"oneTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"valueRangePositionList", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"values", ",", "rangePositions"}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
