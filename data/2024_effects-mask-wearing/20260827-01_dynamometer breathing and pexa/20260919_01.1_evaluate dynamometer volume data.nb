Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "bands95", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"bands95", "[", "l_", "]"}], ":=", 
     RowBox[{"l", "[", 
      RowBox[{"\"\<MeanPredictionBands\>\"", ",", 
       RowBox[{"ConfidenceLevel", "\[Rule]", ".95"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "lnm", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"lnm", "[", 
      RowBox[{
      "l_List", ",", "frameLabelX_String", ",", "frameLabelY_String"}], "]"}],
      ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "lnm", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
