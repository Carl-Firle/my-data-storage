 RowBox[{"newtonFromRIPripcage", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"newtonFromRIPripcage", "[", "v_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", 
    RowBox[{"Around", "[", 
     RowBox[{
      RowBox[{"lnmRipCageGetForce", "[", "v", "]"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Subtract", "@@", 
         RowBox[{"Reverse", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"lnmRipCageGetForce", "[", 
             RowBox[{"\"\<MeanPredictionBands\>\"", ",", 
              RowBox[{"ConfidenceLevel", "->", ".95"}]}], "]"}], " ", "/.", 
            " ", 
            RowBox[{"x", "->", "v"}]}], ")"}]}]}], ")"}], "/", "2"}]}], 
     "]"}]}], "]"}]}], "\[IndentingNewLine]", 
