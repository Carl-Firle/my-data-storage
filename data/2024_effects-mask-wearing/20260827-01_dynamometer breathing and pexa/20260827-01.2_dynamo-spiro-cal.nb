Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "calculate", " ", "volume", " ", "of", " ", "breathing", " ", "for", " ", 
    "the", " ", "original", " ", "dataset", " ", "but", " ", "with", " ", 
    "interpolation", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"dExtrVolume", "=", 
     RowBox[{"TransformColumns", "[", 
      RowBox[{"dExtr", ",", 
       RowBox[{"\"\<volume breathing [ml]\>\"", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Quantity", "[", 
           RowBox[{
            RowBox[{"volumeFunction", "[", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"#", "[", "\"\<elapsed time [s]\>\"", "]"}], "]"}], 
             "]"}], ",", "\"\<Milliliters\>\""}], "]"}], "&"}], ")"}]}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"dExtrVolume", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<elapsed time [s]\>\"", 
        ",", "\"\<volume breathing [ml]\>\""}], "}"}]}], ",", 
     RowBox[{"myPlotSequence", "[", "]"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}], 
       "}"}]}]}], "]"}], "\[IndentingNewLine]"}]}]], "Input",
 CellChangeTimes->{{3.9969837129742184`*^9, 3.996983790749132*^9}, {
