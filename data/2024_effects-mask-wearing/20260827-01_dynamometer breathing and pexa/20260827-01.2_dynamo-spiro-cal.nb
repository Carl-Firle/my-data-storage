           RowBox[{"myPlotSequence", "[", "]"}]}], "]"}], 
         "\[IndentingNewLine]", ",", 
         RowBox[{"Plot", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"lnm", "[", "x", "]"}], ",", 
             RowBox[{"bands95", "[", 
              RowBox[{"lnm", ",", "x"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"Min", "@", 
              RowBox[{"l", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
             RowBox[{"Max", "@", 
              RowBox[{"l", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{"Filling", "\[Rule]", 
            RowBox[{"{", 
             RowBox[{"2", "\[Rule]", 
              RowBox[{"{", "1", "}"}]}], "}"}]}]}], "]"}]}], 
        "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "}"}]}], 
    "\[IndentingNewLine]", "]"}]}], "\n", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
