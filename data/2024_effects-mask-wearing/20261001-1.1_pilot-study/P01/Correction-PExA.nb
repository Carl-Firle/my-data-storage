Cell[BoxData[
 TagBox[
  TagBox[GridBox[{
     {
      InterpretationBox[GridBox[{
         {GridBox[{
            {
             RowBox[{
              RowBox[{"myAroundString", "[", "l_", "]"}], ":=", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", "}"}], ",", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Head", "[", "l", "]"}], "===", "List"}], ",", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"StringJoin", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    "#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}], 
                    "~~", "\<\"\[PlusMinus]\"\>", "~~", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"#1", "\[LeftDoubleBracket]", 
                    RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "]"}]}], 
                    "]"}], "&"}], ")"}], "/@", "l"}], ",", 
