Cell[BoxData[{
 RowBox[{"synchronize", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synchronize", "[", 
    RowBox[{"l_List", ",", "timePosition_Integer", ",", "timeStampName_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"l2", ",", "endTrue"}], "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"l2", "=", "l"}], "\[IndentingNewLine]", ";", 
      RowBox[{"endTrue", "=", 
       RowBox[{"StringContainsQ", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"ToLowerCase", "[", "timeStampName", "]"}], 
          "~~", "\"\<_end\>\""}], ",", 
         RowBox[{
          RowBox[{"Flatten", "[", "startEndTimes", "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"Which", "[", 
       RowBox[{
        RowBox[{"endTrue", "===", "True"}], "\[IndentingNewLine]", ",", 
        RowBox[{
         RowBox[{"l2", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "timePosition"}], "]"}], "]"}], "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"UnitConvert", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"timeStampName", "~~", "\"\<_end\>\""}], "/.", " ", 
                  "protocol"}], ",", "\"\<Seconds\>\""}], "]"}], "-", 
               RowBox[{"Quantity", "[", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"Max", "[", 
                    RowBox[{"l", "[", 
                    RowBox[{"[", 
                    RowBox[{"All", ",", "timePosition"}], "]"}], "]"}], "]"}],
                    "-", "#"}], ")"}], ",", "\"\<Seconds\>\""}], "]"}]}], ",",
               ".5"}], "]"}], "&"}], ",", 
           RowBox[{"l2", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "timePosition"}], "]"}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", ",", 
        RowBox[{"endTrue", "===", "False"}], "\[IndentingNewLine]", ",", 
        RowBox[{
         RowBox[{"l2", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "timePosition"}], "]"}], "]"}], "=", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Round", "[", 
             RowBox[{
              RowBox[{
               RowBox[{"UnitConvert", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"timeStampName", "~~", "\"\<_start\>\""}], "/.", 
