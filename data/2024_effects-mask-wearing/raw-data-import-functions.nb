Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Device", " ", "specification", 
    TemplateBox[{
      RowBox[{" ", 
        RowBox[{
          RowBox[{"Grimm", " ", "11"}], "-", "D"}]}], {
       URL[
       "https://grimm-aerosol.ca/data/documents/Grimm-11-D-Datasheet.pdf"], 
       None}, "https://grimm-aerosol.ca/data/documents/Grimm-11-D-Datasheet.\
pdf", "HyperlinkActionRecycled", {"HyperlinkActive"}, 
      BaseStyle -> {"Hyperlink"}, HyperlinkAction -> "Recycled"},
     "HyperlinkTemplate"]}], "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"dGrimmImport", "=."}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"dGrimmImport", "[", 
     RowBox[{"filename_String", ",", "asName_String"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "dGrimm", ",", "dGrimmVarNames", ",", "model", ",", "unit", ",", 
        "rowVarNames", ",", "rowStartData", ",", "newColumn"}], "}"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{
       RowBox[{"dGrimm", "=", 
        RowBox[{"Import", "[", 
         RowBox[{
          RowBox[{"urlHead", " ", "~~", "filename"}], ",", "\"\<Text\>\""}], 
         "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"dGrimm", "=", 
        RowBox[{"myStringSplit", "[", 
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{"dGrimm", ",", 
            RowBox[{"\"\<,\>\"", "->", "\"\<.\>\""}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<\\n\>\"", ",", "\"\<\\t\>\""}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"model", "=", 
        RowBox[{"dGrimm", "[", 
         RowBox[{"[", 
          RowBox[{"5", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"unit", "=", 
        RowBox[{"Which", "[", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{
            RowBox[{"dGrimm", "[", 
             RowBox[{"[", 
              RowBox[{"9", ",", "1"}], "]"}], "]"}], ",", "\"\<ug/m3\>\""}], 
           "]"}], ",", "\"\<ug/m3\>\"", ",", 
          RowBox[{
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"dGrimm", "[", 
              RowBox[{"[", 
               RowBox[{"9", ",", "1"}], "]"}], "]"}], 
             ",", "\"\<counts/liter\>\""}], "]"}], "||", 
           RowBox[{"StringContainsQ", "[", 
            RowBox[{
             RowBox[{"dGrimm", "[", 
              RowBox[{"[", 
               RowBox[{"9", ",", "1"}], "]"}], "]"}], ",", "\"\<1/l\>\""}], 
            "]"}]}], ",", "\"\<1/L\>\""}], "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", 
          RowBox[{"model", ",", "\"\<11-D\>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{"rowVarNames", "=", "15"}], ";", " ", 
          RowBox[{"rowStartData", "=", "16"}]}], ",", 
         RowBox[{
          RowBox[{"rowVarNames", "=", "14"}], ";", " ", 
          RowBox[{"rowStartData", "=", "15"}]}]}], "]"}], "\n", 
       "\[IndentingNewLine]", ";", 
       RowBox[{"dGrimmVarNames", "=", 
        RowBox[{
         RowBox[{
          RowBox[{
          "asName", "~~", "\"\<_\>\"", "~~", "#", "~~", "\"\< [\>\"", "~~", 
           "unit", "~~", "\"\<]\>\""}], "&"}], "/@", 
         RowBox[{"dGrimm", "[", 
          RowBox[{"[", "rowVarNames", "]"}], "]"}]}]}], "\n", ";", 
       RowBox[{
        RowBox[{"dGrimm", "[", 
         RowBox[{"[", 
          RowBox[{"rowStartData", ";;", 
           RowBox[{"-", "1"}]}], "]"}], "]"}], "=", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"UnixTime", "[", 
              RowBox[{"FromDateString", "[", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<Day\>\"", ",", "\"\<.\>\"", ",", "\"\<Month\>\"",
                   ",", "\"\<.\>\"", ",", "\"\<Year\>\"", ",", "\"\< \>\"", 
                  ",", "\"\<Time\>\""}], "}"}]}], "]"}], "]"}], ",", 
             RowBox[{"ToExpression", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", 
                RowBox[{"2", ";;", 
                 RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}]}], "}"}], "]"}], 
          "&"}], "/@", 
         RowBox[{"dGrimm", "[", 
          RowBox[{"[", 
           RowBox[{"rowStartData", ";;", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "\n", 
       "\[IndentingNewLine]", ";", 
       RowBox[{"dGrimm", "=", 
        RowBox[{"synchronize", "[", 
         RowBox[{
          RowBox[{"dGrimm", "[", 
           RowBox[{"[", 
            RowBox[{"rowStartData", ";;", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], ",", "1", ",", "asName"}], 
         "]"}]}], "\n", ";", 
       RowBox[{"dGrimm", "=", 
        RowBox[{"myFlatten", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"dGrimm", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
             RowBox[{"Map", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"Around", "[", 
                 RowBox[{"#", ",", 
                  RowBox[{"#", ".1"}]}], "]"}], "&"}], ",", 
               RowBox[{"(", 
                RowBox[{"dGrimm", "[", 
                 RowBox[{"[", 
                  RowBox[{"All", ",", 
                   RowBox[{"2", ";;", 
                    RowBox[{"-", "1"}]}]}], "]"}], "]"}], ")"}], ",", 
               RowBox[{"{", "2", "}"}]}], "]"}]}], "}"}], "]"}], " ", ",", 
          "1"}], "]"}]}], " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"error", " ", "of", " ", "10", " ", "%"}], ",", " ", 
