Cell[BoxData[{
 RowBox[{
  RowBox[{"minMaxRanges", "=", 
   RowBox[{"Transpose", "/@", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"minPosition", ",", "maxPosition"}], "}"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"minMaxRanges", "[", 
    RowBox[{"[", 
     RowBox[{"All", ",", "1"}], "]"}], "]"}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"extractInspPhase", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"extractInspPhase", "[", "l_List", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{"dExtrVolume", ",", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "-", 
          RowBox[{"Quantity", "[", 
           RowBox[{".5", ",", "\"\<Seconds\>\""}], "]"}]}], ")"}], "<=", 
        "#\"elapsed time [s]\"", "<=", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", "2", "]"}], "]"}], "+", 
          RowBox[{"Quantity", "[", 
           RowBox[{".5", ",", "\"\<Seconds\>\""}], "]"}]}], ")"}]}], "&"}], 
      ")"}]}], "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"inspiratoryPhases", "=", 
    RowBox[{"extractInspPhase", "/@", 
     RowBox[{"minMaxRanges", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"created", " ", "with", " ", "GPT"}], "-", 
    RowBox[{"5.6", " ", "Sol", " ", "start"}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"minMaxWithTime", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"minMaxWithTime", "[", 
    RowBox[{"data_", ",", "col_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "x", "}"}], ",", 
     RowBox[{
      RowBox[{"x", "=", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"MinimalBy", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{"#", "[", "col", "]"}], "&"}]}], "]"}], ",", 
         RowBox[{"MaximalBy", "[", 
          RowBox[{"data", ",", 
           RowBox[{
            RowBox[{"#", "[", "col", "]"}], "&"}]}], "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Tabular", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\"\<Min\>\"", ",", 
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"x", "[", 
              RowBox[{"1", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], ",", 
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"x", "[", 
              RowBox[{"1", ",", "col"}], "]"}], "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<Max\>\"", ",", 
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"x", "[", 
              RowBox[{"2", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], ",", 
            RowBox[{"QuantityMagnitude", "[", 
             RowBox[{"x", "[", 
              RowBox[{"2", ",", "col"}], "]"}], "]"}]}], "}"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"\"\<type\>\"", ",", "\"\<elapsed time [s]\>\"", 
          ",", "\"\<value\>\""}], "}"}]}], "]"}]}]}], "]"}]}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"created", " ", "with", " ", "GPT"}], "-", 
    RowBox[{"5.6", " ", "Sol", " ", "end"}]}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dMinMax", "=", 
    RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"inspiratoryPlots", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"inspiratoryPlots", "[", "t_Tabular", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "plotVolume", ",", "plotBoth", ",", "tExtr", ",", "minMaxVol", ",", 
       "minMaxDyn1", ",", "minMaxDyn2", ",", "minMaxAll", ",", 
       "plotMinMaxAll", ",", "dVt", ",", "tInspVD1D2", ",", "VolVD1D2"}], 
      "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"tExtr", "=", 
       RowBox[{"t", "[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<elapsed time [s]\>\"", 
           ",", "\"\<volume breathing baseline corrected [100 ml]\>\"", 
           ",", "\"\<dynamometer_1 force [N]\>\"", 
           ",", "\"\<dynamometer_2 force [N]\>\""}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"minMaxVol", "=", 
       RowBox[{"minMaxWithTime", "[", 
        RowBox[{
        "tExtr", 
         ",", "\"\<volume breathing baseline corrected [100 ml]\>\""}], 
        "]"}]}], ";", "\n", 
      RowBox[{"minMaxDyn1", "=", 
       RowBox[{"minMaxWithTime", "[", 
        RowBox[{"tExtr", ",", "\"\<dynamometer_1 force [N]\>\""}], "]"}]}], ";", 
      RowBox[{"minMaxDyn2", "=", 
       RowBox[{"minMaxWithTime", "[", 
        RowBox[{"tExtr", ",", "\"\<dynamometer_2 force [N]\>\""}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"dMinMax", ",", 
        RowBox[{"{", 
         RowBox[{"minMaxVol", ",", "minMaxDyn1", ",", "minMaxDyn2"}], "}"}]}],
        "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
