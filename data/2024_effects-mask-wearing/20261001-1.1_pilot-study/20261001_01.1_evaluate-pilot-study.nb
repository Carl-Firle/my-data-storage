         "\[IndentingNewLine]", 
         RowBox[{"qqPlot", "=", 
          RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"QuantilePlot", "[", 
             RowBox[{"errors", ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"FrameLabel", "->", 
               RowBox[{"{", 
                
                RowBox[{"\"\<theoretical normal quantile [mL]\>\"", 
                 ",", "\"\<observed prediction error quantile [mL]\>\""}], 
                "}"}]}], ",", 
              RowBox[{"myPlotSequence", "[", "]"}], ",", 
              RowBox[{"PlotRange", "->", "All"}]}], "]"}], 
            "\[IndentingNewLine]", ",", 
            RowBox[{"myStyle", "[", 
             RowBox[{"spec", ",", "14", ",", "Bold"}], "]"}], ",", "Top"}], 
           "]"}]}], ";", "\n", "\[IndentingNewLine]", 
         RowBox[{"swTest", "=", 
          RowBox[{"ShapiroWilkTest", "[", 
           RowBox[{"errors", ",", "\"\<TestDataTable\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"Clear", "[", 
          RowBox[{"mu", ",", "sigma"}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"ksTest", "=", 
          RowBox[{"KolmogorovSmirnovTest", "[", 
           RowBox[{"errors", ",", 
            RowBox[{"NormalDistribution", "[", 
             RowBox[{"mu", ",", "sigma"}], "]"}], 
            ",", "\"\<TestDataTable\>\""}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"bias", "=", 
