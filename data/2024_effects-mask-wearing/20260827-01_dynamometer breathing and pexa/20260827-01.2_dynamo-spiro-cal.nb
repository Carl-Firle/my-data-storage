   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"maxPositionTime", "=", 
   RowBox[{
    RowBox[{"dExtrVolume", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"maxPosition", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
