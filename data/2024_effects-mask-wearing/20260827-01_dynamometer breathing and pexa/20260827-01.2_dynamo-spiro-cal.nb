    RowBox[{
     RowBox[{
      RowBox[{"-", "1"}], "*", 
      RowBox[{"dExtrVolume", "[", 
       RowBox[{"[", 
        RowBox[{
        "All", ",", "\"\<volume breathing baseline corrected [ml]\>\""}], 
        "]"}], "]"}]}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"minPosition", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "/=", "100"}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"for", " ", "comprehensive", " ", "graphical", " ", "output"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minPositionTime", "=", 
   RowBox[{
    RowBox[{"dExtrVolume", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"minPosition", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"minPosition", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"minPositionTime", ",", 
       RowBox[{
        RowBox[{"-", "1"}], "*", 
        RowBox[{"minPosition", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotVolumeCorDynamometerMinMax", "=", 
   RowBox[{"Show", "[", "\[IndentingNewLine]", 
    RowBox[{"volumePlotCorrectedScaled", "\[IndentingNewLine]", ",", 
     RowBox[{"ListLinePlot", "[", 
      RowBox[{
       RowBox[{"dExtrVolume", "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           
           RowBox[{"\"\<elapsed time [s]\>\"", 
            ",", "\"\<dynamometer_1 force [N]\>\""}], "}"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<elapsed time [s]\>\"", 
            ",", "\"\<dynamometer_2 force [N]\>\""}], "}"}]}], "}"}]}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"PlotLegends", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<dynamometer_1 force abdomen [N]\>\"", 
          ",", "\"\<dynamometer_2 force thorax [N]\>\""}], "}"}]}], ",", 
       RowBox[{"myPlotSequence", "[", "]"}], ",", 
       RowBox[{"PlotRange", "->", 
        RowBox[{"{", 
         RowBox[{"plotRangeX", ",", "All"}], "}"}]}]}], "]"}], 
     "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"maxPosition", ",", "minPosition"}], "}"}], ",", 
       RowBox[{"myPlotSequence", "[", "]"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"PointSize", "[", "Large", "]"}], ",", "StandardGreen"}], 
         "]"}]}]}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
     RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myFigAppend", "[", 
   RowBox[{"{", 
