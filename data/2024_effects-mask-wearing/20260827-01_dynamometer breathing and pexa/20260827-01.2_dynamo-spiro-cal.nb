Cell[BoxData[{
 RowBox[{
  RowBox[{"maxPosition", "=", 
   RowBox[{"FindPeaks", "[", 
    RowBox[{
     RowBox[{"dExtrVolume", "[", 
      RowBox[{"[", 
       RowBox[{
       "All", ",", "\"\<volume breathing baseline corrected [ml]\>\""}], 
       "]"}], "]"}], ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxPosition", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "/=", "100"}], ";"}], 
  RowBox[{"(*", 
