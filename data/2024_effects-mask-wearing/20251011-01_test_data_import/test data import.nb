            RowBox[{"(", 
             RowBox[{"#2", "-", "#1"}], ")"}], "/", "2"}], ",", "0", ",", 
           RowBox[{"-", ".5"}]}], "]"}]}], ")"}], "&"}], "@@@", 
      "rangePositions"}], "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", "\"\<countdown\>\""}], "]"}], 
     "\[IndentingNewLine]", ";", 
