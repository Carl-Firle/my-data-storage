       "\[IndentingNewLine]", ";", 
       RowBox[{"temp", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"temp", "[", 
           RowBox[{"[", 
            RowBox[{"#1", ";;", "#2"}], "]"}], "]"}], "&"}], "@@@", 
