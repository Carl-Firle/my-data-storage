 RowBox[{
  RowBox[{
   RowBox[{"dProtocolImport", "[", "filename_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"dProtocol", ",", "timeline", ",", "var"}], "}"}], ",", 
     RowBox[{
