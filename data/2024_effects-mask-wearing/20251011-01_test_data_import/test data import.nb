Cell[BoxData[{
 RowBox[{"measurementTimesImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"measurementTimesImport", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "temp", ",", "timepoints", ",", "values", ",", "rangePositions", ",", 
      "newColumn", ",", "valueRangePositionList"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"temp", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        StyleBox["protocol",
         FontColor->GrayLevel[0]], ",", 
        RowBox[{
         RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<measurement\>\""}], 
          "]"}], "&"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"temp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"StringSplit", "[", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<***\>\""}], "]"}], "->", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", 
       RowBox[{"Normal", "[", "temp", "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"timepoints", "=", 
      RowBox[{"GatherBy", "[", 
       RowBox[{"temp", ",", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "&"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"timepoints", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"#", ",", 
            RowBox[{
             RowBox[{"StringContainsQ", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<_start\>\"", ",", "\"\<_end\>\""}], "}"}]}], 
              "]"}], "&"}]}], "]"}], "&"}], "/@", "timepoints"}], ")"}], " ", 
       "/.", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", "}"}], "->", "Nothing"}], ")"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"temp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "==", 
           RowBox[{"Length", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}], ",", 
          RowBox[{"Transpose", "[", "#", "]"}], ",", 
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"Append", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "[", 
                RowBox[{"[", 
                 RowBox[{"2", ";;", 
                  RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"{", "\"\<measurement_end\>\"", "}"}], "->", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"\"\<end of protocol\>\"", "/.", "protocol"}], 
                  ")"}], "-", 
                 RowBox[{"Quantity", "[", 
                  RowBox[{"1", ",", "\"\<Seconds\>\""}], "]"}]}]}]}], "]"}]}],
             "}"}], "]"}]}], "]"}], "&"}], "@", "timepoints"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"values", "=", 
      RowBox[{"StringRiffle", "/@", 
       RowBox[{
        RowBox[{"temp", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "1"}]}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"rangePositions", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"positionInTimeline", ",", 
        RowBox[{"temp", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All", ",", 
           RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"oneTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"valueRangePositionList", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"values", ",", "rangePositions"}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"newColumn", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"#2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ";;", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
         RowBox[{"Table", "[", 
          RowBox[{"#1", ",", 
           RowBox[{"Length", "[", 
            RowBox[{"newColumn", "[", 
             RowBox[{"[", 
              RowBox[{
               RowBox[{"#2", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ";;", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}]}], 
          "]"}]}], ")"}], "&"}], "@@@", "valueRangePositionList"}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", "\"\<measurement task\>\""}], "]"}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"oneTable", ",", "newColumn"}], "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "Input",
