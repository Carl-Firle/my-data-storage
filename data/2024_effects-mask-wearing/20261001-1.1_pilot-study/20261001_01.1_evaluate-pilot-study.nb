             "original", " ", 
             RowBox[{"dataset", ".", " ", "The"}], " ", "data", " ", 
             "extract", " ", "has", " ", "to", " ", "size", " ", "the", " ", 
             "baseline", " ", "interpolation", " ", 
             RowBox[{"range", "."}]}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"dExtrVolume", "=", 
