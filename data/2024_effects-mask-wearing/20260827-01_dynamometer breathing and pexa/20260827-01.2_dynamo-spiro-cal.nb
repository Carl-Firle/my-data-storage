Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"dExtr", "=", 
    RowBox[{"Select", "[", 
     RowBox[{"oneTableTab", ",", 
      RowBox[{
       RowBox[{
        RowBox[{
        "MissingQ", "[", "#\"pexa_Inhale Exhale Airflow [ml/s]\"", "]"}], "===",
         "False"}], "&"}]}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"timeFlowData", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"myNormalColumnTab", "[", 
        RowBox[{"dExtr", ",", "\"\<elapsed time [s]\>\""}], "]"}], ",", 
       RowBox[{"myNormalColumnTab", "[", 
        RowBox[{"dExtr", ",", "\"\<pexa_Inhale Exhale Airflow [ml/s]\>\""}], 
        "]"}]}], "}"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"created", " ", "with", " ", "GPT"}], "-", 
    RowBox[{
    "5.6", " ", "sol", " ", "except", " ", "comments", " ", "_", " ", 
     "start"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"airflowToVolume", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"airflowToVolume", "[", "data_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "time", ",", "flow", ",", "deltaT", ",", "deltaV", ",", "volume"}], 
      "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"time", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"flow", "=", 
       RowBox[{"data", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"deltaT", "=", 
       RowBox[{"Differences", "[", "time", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"deltaV", "=", 
       RowBox[{
        RowBox[{"-", "deltaT"}], "*", 
        RowBox[{"MovingAverage", "[", 
         RowBox[{"flow", ",", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"volume", "=", 
       RowBox[{"Prepend", "[", 
        RowBox[{
         RowBox[{"Accumulate", "[", "deltaV", "]"}], ",", "0"}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"time", ",", "volume"}], "}"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"volumeData", "=", 
   RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rawVolume", "=", 
   RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ListLinePlot", "[", 
   RowBox[{"volumeData", ",", 
    RowBox[{"myPlotSequence", "[", "]"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}], 
      "}"}]}]}], "]"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "find", " ", "positive", " ", "to", " ", "negative", " ", "sign", " ", 
     "changes", " ", "and", " ", "replace", " ", "with", " ", "averaged", " ",
      "value"}], " ", "=", "  ", 
    RowBox[{
     RowBox[{
     "linear", " ", "interpolation", " ", "of", " ", "the", " ", "exact", " ",
       "zero", " ", "crossing", " ", "at", " ", "the", " ", "end"}], "-", 
     RowBox[{"expiratory", " ", "phase"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"endExpiration", "=", 
    RowBox[{"Cases", "[", 
     RowBox[{
      RowBox[{"Partition", "[", 
       RowBox[{"timeFlowData", ",", "2", ",", "1"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t1_", ",", "q1_"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"t2_", ",", "q2_"}], "}"}]}], "}"}], "/;", 
        RowBox[{
         RowBox[{"q1", ">", "0"}], "&&", 
         RowBox[{"q2", "<", "0"}]}]}], ":>", 
       RowBox[{"t1", "-", 
        RowBox[{"q1", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"t2", "-", "t1"}], ")"}], "/", 
          RowBox[{"(", 
           RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "interpolate", " ", "raw", " ", "volume", " ", "data", " ", "and", " ", 
     "baseline", " ", "points", " ", "from", " ", "end"}], "-", 
    RowBox[{"expiratory", " ", "phase"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"volumeFunction", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"rawVolume", ",", 
      RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baselinePoints", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"#", ",", 
       RowBox[{"volumeFunction", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
    "endExpiration"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"baseline", "=", 
    RowBox[{"Interpolation", "[", 
     RowBox[{"baselinePoints", ",", 
      RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "correct", " ", "volume", " ", "with", " ", "interpolated", " ", 
     "baseline", " ", "data"}], " ", "->", " ", 
    RowBox[{"v", "-", 
     RowBox[{"baseline", "[", "t", "]"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"correctedVolume", "=", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"rawVolume", ",", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"First", "[", "baselinePoints", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", 
         RowBox[{"#", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "<=", 
         RowBox[{
          RowBox[{"Last", "[", "baselinePoints", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}], "/.", " ", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"t_", ",", "v_"}], "}"}], ":>", 
      RowBox[{"{", 
       RowBox[{"t", ",", 
        RowBox[{"v", "-", 
         RowBox[{"baseline", "[", "t", "]"}]}]}], "}"}]}]}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", "plots", "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"volumePlot", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"correctedVolume", ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"myPlotSequence", "[", "]"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}], 
       "}"}]}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotVolumeRawVsCorrected", "=", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rawVolume", ",", "correctedVolume"}], "}"}], ",", 
     RowBox[{"PlotRange", "->", "All"}], ",", 
     RowBox[{"myPlotSequence", "[", "]"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}], 
       "}"}]}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotVolumeRawBaselineCorr", "=", 
   RowBox[{"Show", "[", 
    RowBox[{
     RowBox[{"ListLinePlot", "[", 
      RowBox[{"rawVolume", ",", 
       RowBox[{"PlotRange", "->", "All"}], ",", 
       RowBox[{"FrameLabel", "->", 
        RowBox[{"{", 
         RowBox[{"\"\<elapsed time [s]\>\"", ",", 
          " ", "\"\<volume [ml]\>\""}], "}"}]}]}], "]"}], ",", 
     RowBox[{"ListPlot", "[", 
      RowBox[{"baselinePoints", ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"PointSize", "[", "Large", "]"}], ",", "Red"}], "]"}]}]}], 
      "]"}], ",", 
     RowBox[{"Plot", "[", 
      RowBox[{
       RowBox[{"baseline", "[", "t", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"First", "[", "baselinePoints", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"Last", "[", "baselinePoints", "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
     RowBox[{"myPlotSequence", "[", "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"myFigAppend", "[", 
   RowBox[{"{", 
    RowBox[{"plotVolumeRawVsCorrected", ",", "\"\<002\>\"", ",", 
     RowBox[{"\"\<plot interpolated volume baseline corrected vs raw volume \
data\>\"", "<>", "\"\<_\>\"", "<>", "mode"}], ",", "300", ",", "True"}], 
    "}"}], "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"myFigAppend", "[", 
    RowBox[{"{", 
     RowBox[{"plotVolumeRawBaselineCorr", ",", "\"\<003\>\"", ",", 
      RowBox[{"\"\<plot raw volume with baseline detection\>\"", 
       "<>", "\"\<_\>\"", "<>", "mode"}], ",", "300", ",", "True"}], "}"}], 
    "]"}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
