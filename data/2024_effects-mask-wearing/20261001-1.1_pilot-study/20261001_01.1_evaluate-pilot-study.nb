                RowBox[{"\"\<prediction error (\!\(\*SubscriptBox[\(volume\), \
\(measured\)]\) \[Minus] \!\(\*SubscriptBox[\(volume\), \(predicted\)]\)) \
[ml]\>\"", ",", "\"\<fraction of breahts\>\""}], "}"}]}], ",", 
              RowBox[{"myPlotSequence", "[", "]"}]}], "\[IndentingNewLine]", 
