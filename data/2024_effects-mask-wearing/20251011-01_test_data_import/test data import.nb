                RowBox[{"\"\<_start\>\"", ",", "\"\<_end\>\""}], "}"}]}], 
              "]"}], "&"}]}], "]"}], "&"}], "/@", "timepoints"}], ")"}], " ", 
       "/.", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"{", "}"}], "->", "Nothing"}], ")"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"temp", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
