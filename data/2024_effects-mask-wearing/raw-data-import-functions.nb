Notebook[{
Cell[BoxData[{
 RowBox[{"protocolSelect", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"protocolSelect", "[", "varName_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "check", "}"}], ",", 
     RowBox[{
      RowBox[{"check", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{
            RowBox[{"Keys", "[", "#", "]"}], ",", "varName"}], "]"}], "&"}]}],
         "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"check", "==", 
         RowBox[{"{", "}"}]}], ",", "Nothing", ",", "check"}], "]"}]}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"strContQ", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"strContQ", "[", 
    RowBox[{"v_", ",", "t_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"StringContainsQ", "[", 
      RowBox[{
       RowBox[{"v", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", "#"}], "]"}], "&"}], "/@", 
    "t"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stringFix", "=", 
    RowBox[{
    "Import", 
     "[", "\"\<https://github.com/Carl-Firle/effects-of-mask-wearing-on-human-\
particle-formation/raw/refs/heads/main/methods/stringFix_for_protocol.m\>\"", 
     "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"dProtocolImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dProtocolImport", "[", "filename_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "dProtocol", ",", "dProtocolRepl", ",", "timeline", ",", "var"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{"dProtocol", "=", 
       RowBox[{"Import", "[", 
        RowBox[{"urlHead", " ", "~~", "filename"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dProtocol", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"dProtocol", ",", "stringFix"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dProtocolRepl", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"StringSplit", "[", 
          RowBox[{"dProtocol", ",", "\"\< --- \>\""}], "]"}], ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{"#", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<comment***\>\"", "~~", "__", "~~", "\"\<->\>\""}], 
             "}"}]}], "]"}], "&"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"dProtocolRepl", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"myStringSplit", "[", 
          RowBox[{"#", ",", 
           RowBox[{"{", 
            
            RowBox[{"\"\<comment***\>\"", ",", "\"\< -> \>\"", 
             ",", "\"\< :: \>\""}], "}"}]}], "]"}], "&"}], "/@", 
        "dProtocolRepl"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"dProtocolRepl", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "2", ",", "1"}], "]"}], "]"}], 
            "~~", "\"\< :: \>\"", "~~", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "1", ",", "2"}], "]"}], "]"}]}], "->", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", 
               RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}], 
            "~~", "\"\< :: \>\"", "~~", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", 
               RowBox[{"-", "1"}], ",", "2"}], "]"}], "]"}]}]}], ")"}], "&"}],
         "/@", "dProtocolRepl"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"dProtocol", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"dProtocol", ",", "dProtocolRepl"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"protocol", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "->", 
          RowBox[{"Quantity", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ToExpression", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "/", "1000."}], 
            ",", "\"\<Seconds\>\""}], "]"}]}], "&"}], "/@", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{"myStringSplit", "[", 
           RowBox[{"dProtocol", ",", 
            RowBox[{"{", 
             RowBox[{"\"\< --- \>\"", ",", "\"\< :: \>\""}], "}"}]}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"StringContainsQ", "[", 
             RowBox[{
              RowBox[{"StringJoin", "[", "#", "]"}], ",", 
              
              RowBox[{"\"\<comment***\>\"", "~~", "__", 
               "~~", "\"\< -> \>\""}]}], "]"}], "==", "False"}], "&"}]}], 
         "]"}]}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"protocol", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "->", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"Min", "[", 
            RowBox[{"Values", "@", "protocol"}], "]"}]}]}], "&"}], "/@", 
        "protocol"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"\"\<_start\>\"", "|", "\"\<_end\>\""}]}], "]"}], "&"}]}],
         "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{"startEndTimes", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{"ToLowerCase", "/@", 
        RowBox[{"startEndTimes", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      ";", 
      RowBox[{"var", "=", 
       RowBox[{"Union", "[", 
        RowBox[{"ToLowerCase", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"StringReplace", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\"\<_start\>\"", "->", "\"\<\>\""}], ",", 
                RowBox[{"\"\<_end\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}], 
            "&"}], "/@", 
           RowBox[{"startEndTimes", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"startEndTimes", ",", 
         RowBox[{
          RowBox[{"strContQ", "[", 
           RowBox[{"#", ",", "var"}], "]"}], "&"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GatherBy", "[", 
          RowBox[{"#", ",", "First"}], "]"}], "&"}], "/@", 
        "startEndTimes"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
       RowBox[{"startEndTimes", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"timeline", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Values", "[", 
               RowBox[{
               "protocolSelect", "[", "\"\<end of protocol\>\"", "]"}], "]"}],
               "-", 
              RowBox[{"Values", "[", 
               RowBox[{"protocolSelect", "[", "\"\<start time\>\"", "]"}], 
               "]"}]}], ")"}], " ", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "+", "0.5"}], ",", ".5"}], "]"}]}],
       "\[IndentingNewLine]", ";", 
      RowBox[{"varNames", "=", 
       RowBox[{"{", "\"\<elapsed time [s]\>\"", "}"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"oneTable", "=", 
       RowBox[{"{", "timeline", "}"}]}], "\[IndentingNewLine]", 
      ";", "\"\<Import successful\>\""}]}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
