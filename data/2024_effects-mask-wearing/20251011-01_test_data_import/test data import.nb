                 RowBox[{"(", 
                  RowBox[{"\"\<end of protocol\>\"", "/.", "protocol"}], 
                  ")"}], "-", 
                 RowBox[{"Quantity", "[", 
                  RowBox[{"1", ",", "\"\<Seconds\>\""}], "]"}]}]}]}], "]"}]}],
             "}"}], "]"}]}], "]"}], "&"}], "@", "timepoints"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"values", "=", 
      RowBox[{"StringRiffle", "/@", 
       RowBox[{
        RowBox[{"temp", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "1"}]}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"rangePositions", "=", 
