           RowBox[{"Median", "[", "errors", "]"}]}]}], ";", "\n", "\t", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"loaLower", ",", "loaUpper"}], "}"}], "=", 
          RowBox[{"Quantile", "[", 
           RowBox[{"errors", ",", 
            RowBox[{"{", 
             RowBox[{"0.025", ",", "0.975"}], "}"}]}], "]"}]}], ";", "\n", 
         "\[IndentingNewLine]", 
         RowBox[{"baModified", "=", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<bias as median [mL]\>\"", "->", "bias"}], ",", 
            
            RowBox[{"\"\<lower empirical percentile limit [mL]\>\"", "->", 
             "loaLower"}], ",", 
            
            RowBox[{"\"\<upper empirical percentile limit [mL]\>\"", "->", 
             "loaUpper"}]}], "|>"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", 
         RowBox[{"baModifiedPlot", "=", 
          RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
