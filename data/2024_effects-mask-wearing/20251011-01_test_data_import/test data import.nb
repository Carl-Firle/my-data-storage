               ",", "\"\<measurement_end\>\""}], "}"}]}], "]"}], "&"}]}], 
         "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"search", "=", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
