            RowBox[{"\"\<predicted volume from\\n\>\"", "<>", "spec", 
             "<>", "\"\< dynamometer [ml]\>\""}]}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{
           "calculate", " ", "errors", " ", "and", " ", "show", " ", 
