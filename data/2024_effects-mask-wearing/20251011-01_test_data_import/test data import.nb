         RowBox[{"timepoints", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"{", "3", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"newColumn", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{"\"\<n.a.\>\"", ",", 
