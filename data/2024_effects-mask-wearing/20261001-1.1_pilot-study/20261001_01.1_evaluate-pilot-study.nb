              RowBox[{"PlotStyle", "->", 
               RowBox[{"Directive", "[", 
                RowBox[{"Blue", ",", 
                 RowBox[{"PointSize", "[", "0.016", "]"}]}], "]"}]}], ",", 
              RowBox[{"PlotRange", "->", 
               RowBox[{"{", 
                RowBox[{"All", ",", 
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"Min", "[", 
