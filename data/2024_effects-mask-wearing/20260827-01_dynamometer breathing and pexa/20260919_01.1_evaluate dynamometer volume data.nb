           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Position", " ", "of", " ", "the", " ", "volume", " ", 
             "maximum"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"posVMax", "=", 
            RowBox[{
             RowBox[{"FirstPosition", "[", 
              RowBox[{"time", ",", "vMax"}], "]"}], "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           "\n", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"findOne", "[", "column_", "]"}], ":=", 
            RowBox[{"Module", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
               "values", ",", "posMin1", ",", "posMax", ",", "posMin2"}], 
