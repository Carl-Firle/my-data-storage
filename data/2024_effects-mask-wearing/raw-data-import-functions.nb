               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{"Append", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "[", 
                 RowBox[{"[", 
                  RowBox[{"2", ";;", 
                   RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
                RowBox[{
                 RowBox[{"{", "\"\<measurement_end\>\"", "}"}], "->", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"\"\<end of protocol\>\"", "/.", "protocol"}], 
                   ")"}], "-", 
                  RowBox[{"Quantity", "[", 
                   RowBox[{"1", ",", "\"\<Seconds\>\""}], "]"}]}]}]}], 
               "]"}]}], "}"}], "]"}]}], "]"}], "&"}], "@", "timepoints"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"values", "=", 
       RowBox[{"StringRiffle", "/@", 
        RowBox[{
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1", ",", "1"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", 
           RowBox[{"2", ";;", 
            RowBox[{"-", "1"}]}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"rangePositions", "=", 
       RowBox[{"Map", "[", 
        RowBox[{"positionInTimeline", ",", 
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"newColumn", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"\"\<n.a.\>\"", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"oneTable", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"valueRangePositionList", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"values", ",", "rangePositions"}], "}"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"newColumn", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"#2", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ";;", 
             RowBox[{"#2", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
          RowBox[{"Table", "[", 
           RowBox[{"#1", ",", 
            RowBox[{"Length", "[", 
             RowBox[{"newColumn", "[", 
              RowBox[{"[", 
               RowBox[{
                RowBox[{"#2", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ";;", 
                RowBox[{"#2", "[", 
                 RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}]}], 
           "]"}]}], ")"}], "&"}], "@@@", "valueRangePositionList"}], 
