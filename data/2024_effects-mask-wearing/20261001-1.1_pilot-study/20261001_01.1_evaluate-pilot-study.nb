               RowBox[{
                RowBox[{"Association", "[", "#", "]"}], ",", "dyn"}], 
               "]"}]}]}], "&"}], "/@", "dvalBreathChar"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dvalPred", "=", 
          RowBox[{"Association", "/@", 
           RowBox[{"myFlatten", "[", 
            RowBox[{
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"\[CapitalDelta]VInspPredVol", ",", "dvalBreathChar"}],
                "}"}], "]"}], ",", "1"}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"dVolMeasPred", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}], ",", 
              RowBox[{
              "#", "[", "\"\<\[CapitalDelta]VInspPredVol\>\"", "]"}]}], "}"}],
             "&"}], "/@", "dvalPred"}]}], ";", "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "\n", "\t ", 
         RowBox[{"ClearAll", "[", "bands95", "]"}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bands95", "[", "l_", "]"}], ":=", 
          RowBox[{"l", "[", 
