             RowBox[{"Association", "[", "myOutput", "]"}], 
             "[", "\"\<validation\>\"", "]"}], "]"}], 
           "[", "\"\<breath characteristic values\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"\[CapitalDelta]VInspPredVol", "=", 
          RowBox[{
