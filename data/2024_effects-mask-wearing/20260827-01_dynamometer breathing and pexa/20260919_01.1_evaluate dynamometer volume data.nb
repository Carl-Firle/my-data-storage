Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "bandsSingle95", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bandsSingle95", "[", "l_", "]"}], ":=", 
    RowBox[{"l", "[", 
     RowBox[{"\"\<SinglePredictionBands\>\"", ",", 
      RowBox[{"ConfidenceLevel", "\[Rule]", ".95"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"band", "=", 
   RowBox[{"bandsSingle95", "[", "fVThorax", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"insideBand", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"dn", ",", "v", ",", "bounds"}], "}"}], ",", 
        RowBox[{
         RowBox[{"dn", "=", 
          RowBox[{"#", "[", "\"\<\[CapitalDelta]NInspDynT\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"v", "=", 
          RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"bounds", "=", 
          RowBox[{"band", "/.", " ", 
           RowBox[{"x", "->", "dn"}]}]}], ";", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"bounds", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", "v", "<=", 
          RowBox[{"bounds", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}]}]}], "]"}], ")"}], "&"}], "/@", 
    "dvalPred"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"percInFitCI", "=", 
   RowBox[{"N", "[", 
    RowBox[{"100", " ", 
     RowBox[{"Mean", "[", 
      RowBox[{"Boole", "/@", "insideBand"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Show", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"ListPlot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"#", "[", "\"\<\[CapitalDelta]NInspDynT\>\"", "]"}], ",", 
            RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}]}], 
           "}"}], "&"}], "/@", "dvalPred"}], ",", 
        RowBox[{"FrameLabel", "->", 
         RowBox[{"{", 
          
          RowBox[{"\"\<dynamometer thorax [N]\>\"", 
           ",", "\"\<measured volume [ml]\>\""}], "}"}]}], ",", 
        RowBox[{"myPlotSequence", "[", "]"}], ",", 
        RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", "]"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"fVThorax", "[", "x", "]"}], ",", 
          RowBox[{"bandsSingle95", "[", "fVThorax", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", 
          RowBox[{"Min", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<\[CapitalDelta]NInspDynT\>\"", "]"}], 
             "&"}], "/@", "dvalPred"}], "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", "\"\<\[CapitalDelta]NInspDynT\>\"", "]"}], 
             "&"}], "/@", "dvalPred"}], "]"}]}], "}"}], ",", 
        RowBox[{"Filling", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"2", "\[Rule]", 
           RowBox[{"{", "1", "}"}]}], "}"}]}]}], "]"}]}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
    "\[IndentingNewLine]", ",", 
    RowBox[{"myStyle", "[", 
     RowBox[{
      RowBox[{"\"\<\\nfit with 95% single prediction band is from calibration \
data (within CI \>\"", "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"Round", "[", "percInFitCI", "]"}], "]"}], 
       "<>", "\"\<%)\>\""}], ",", "Bold"}], "]"}]}], "\[IndentingNewLine]", 
   "]"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
