            RowBox[{"newColumn", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", 
               RowBox[{"#1", ";;", "#2"}]}], "]"}], "]"}], 
            "=", "\"\<open\>\""}], ")"}], "&"}], "@@@", 
         RowBox[{"rangePositions", "[", 
