         RowBox[{"minMaxVol", ",", "minMaxDyn1", ",", "minMaxDyn2"}], 
         "}"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"plotMinMaxAll", "=", 
       RowBox[{"ListPlot", "[", 
        RowBox[{
         RowBox[{"minMaxAll", "->", 
          RowBox[{"{", 
           RowBox[{"\"\<elapsed time [s]\>\"", ",", "\"\<value\>\""}], 
           "}"}]}], ",", 
         RowBox[{"PlotStyle", "->", 
          RowBox[{"Directive", "[", 
           RowBox[{
            RowBox[{"PointSize", "[", "Large", "]"}], ",", "StandardGreen"}], 
           "]"}]}], ",", 
         RowBox[{"myPlotSequence", "[", "]"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"plotVolume", "=", 
       RowBox[{"ListLinePlot", "[", 
        RowBox[{
         RowBox[{"t", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<elapsed time [s]\>\"", 
            ",", "\"\<volume breathing baseline corrected [100 ml]\>\""}], 
           "}"}]}], ",", 
         RowBox[{"myPlotSequence", "[", "]"}], ",", 
         RowBox[{"PlotStyle", "->", "Black"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{
          "{", "\"\<volume breathing baseline corrected [100 ml]\>\"", 
           "}"}]}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           
           RowBox[{"\"\<elapsed time [s]\>\"", ",", 
            " ", "\"\<mixed scale, see legend\>\""}], "}"}]}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "\n", 
      RowBox[{"plotBoth", "=", 
       RowBox[{"Show", "[", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"plotVolume", "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"t", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               
               RowBox[{"\"\<elapsed time [s]\>\"", 
                ",", "\"\<dynamometer_1 force [N]\>\""}], "}"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<elapsed time [s]\>\"", 
                ",", "\"\<dynamometer_2 force [N]\>\""}], "}"}]}], "}"}]}], 
           "\[IndentingNewLine]", ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<dynamometer_1 force thorax [N]\>\"", 
              ",", "\"\<dynamometer_2 force abdomen [N]\>\""}], "}"}]}], 
           "\[IndentingNewLine]", ",", 
