 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "breathing", " ", "cycle", " ", "shall", " ", "allways", " ", "start", " ",
      "with", " ", "minimum"}], " ", "=", " ", 
    RowBox[{"inspiration", " ", "phase"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"maxPosition", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
      RowBox[{"minPosition", "[", 
