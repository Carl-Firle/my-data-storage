             RowBox[{
              RowBox[{"dMS30", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", 
              RowBox[{"dMS30", "[", 
               RowBox[{"[", "5", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"2", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<time\>\"", ",", "\"\<hh:mm:ss\>\""}], "}"}]}]}], 
          "]"}]}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"3", ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"dMS30", "=", " ", 
      RowBox[{
