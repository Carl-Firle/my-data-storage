             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<load_start\>\"", ",", "\"\<load_total\>\"", 
               ",", "\"\<measurement_end\>\""}], "}"}]}], "]"}], "&"}]}], 
         "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"search", "=", 
        RowBox[{"Union", "[", 
