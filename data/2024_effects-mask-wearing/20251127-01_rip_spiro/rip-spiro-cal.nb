Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"breathDetect", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"breathDetect", "[", "l_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "peaks", ",", "peaksLow", ",", "xdiffs", ",", "linesDiff", ",", 
       "xDiffSeconds", ",", "yDiffVolume"}], "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"values", "=", 
       RowBox[{"l", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"peaks", "=", 
       RowBox[{"FindPeaks", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "3"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "10"}], "]"}]}], ";",
       "\n", 
      RowBox[{"peaksLow", "=", 
       RowBox[{"FindPeaks", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"l", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "3"}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "10"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"peaks", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
         RowBox[{"peaksLow", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"peaks", "=", 
         RowBox[{"Delete", "[", 
          RowBox[{"peaks", ",", "1"}], "]"}]}], ",", "Nothing"}], "]"}], " ", 
      ";", 
      RowBox[{"(*", 
       RowBox[{
       "start", " ", "with", " ", "first", " ", "inspiration", " ", 
        "volume"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"peaksLow", "=", 
       RowBox[{"peaksLow", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"peaksLow", "=", 
       RowBox[{"peaksLow", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"xdiffs", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", 
              RowBox[{"Round", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@",
            "peaksLow"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", 
              RowBox[{"Round", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@",
            "peaks"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"linesDiff", "=", 
       RowBox[{"Line", "/@", "xdiffs"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xDiffSeconds", "=", 
       RowBox[{"-", 
        RowBox[{"Subtract", "@@@", 
         RowBox[{"xdiffs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}]}]}], ";", 
      " ", 
      RowBox[{"(*", 
       RowBox[{"inspiratory", " ", "breathing", " ", "duration"}], "*)"}], 
      "\[IndentingNewLine]", 
      RowBox[{"yDiffVolume", "=", 
       RowBox[{"-", 
        RowBox[{"Subtract", "@@@", 
         RowBox[{"xdiffs", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}]}]}], " ", ";", 
      RowBox[{"(*", 
       RowBox[{"inspiratory", " ", "breathing", " ", "volume"}], "*)"}], 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Tabular", "[", 
         RowBox[{
          RowBox[{"Transpose", "[", 
           RowBox[{"{", 
            RowBox[{"xDiffSeconds", ",", "yDiffVolume"}], "}"}], "]"}], ",", 
          RowBox[{"{", 
           
           RowBox[{"\"\<\[CapitalDelta] insp. time [s]\>\"", 
            ",", "\"\<\[CapitalDelta] insp. volume [l]\>\""}], "}"}]}], "]"}],
         ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"Show", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"values", ",", 
              RowBox[{
               RowBox[{
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"Round", "@", "#"}], "]"}], "]"}], "&"}], "/@", " ", 
               RowBox[{"peaks", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"Round", "@", "#"}], "]"}], "]"}], "&"}], "/@", " ", 
               RowBox[{"peaksLow", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
            RowBox[{"PlotLabel", "->", 
             RowBox[{"myStyle", "@", 
              RowBox[{"l", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", "\"\<spirometry\>\"", "}"}]}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              
              RowBox[{"\"\<time [s]\>\"", 
               ",", "\"\<breathing volume [l]\>\""}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"Joined", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"True", ",", "False", ",", "False"}], "}"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{"PlotStyle", "\[Rule]", 
             RowBox[{"{", 
              RowBox[{"Automatic", ",", 
               RowBox[{"PointSize", "[", ".02", "]"}], ",", 
               RowBox[{"PointSize", "[", ".02", "]"}], ",", 
               RowBox[{"PlotRange", "->", "All"}]}], "}"}]}], ",", 
            RowBox[{"ImageSize", "->", "Large"}], ",", 
            RowBox[{"Frame", "->", "True"}], ",", 
            RowBox[{"myFrameStyle", "[", "]"}], ",", 
            RowBox[{"myFrameTickStyle", "[", "]"}]}], "\[IndentingNewLine]", 
           "]"}], "\[IndentingNewLine]", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"Graphics", "[", 
             RowBox[{"{", 
              RowBox[{"Thick", ",", "Red", ",", "#"}], "}"}], "]"}], "&"}], "/@",
            "linesDiff"}]}], "\[IndentingNewLine]", "]"}]}], "}"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"spiroBreaths", "=", 
  RowBox[{
  "breathDetect", "/@", " ", 
   "dataForAnalysis"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.955443239242569*^9, 3.955443265381155*^9}, {
