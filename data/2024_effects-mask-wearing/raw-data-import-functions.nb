       RowBox[{"[", 
        RowBox[{"1", ",", "All", ",", "1", ",", "1", ",", "2"}], "]"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"loadTimes", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"positionInTimeline", ",", 
        RowBox[{"temp", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"valueRangePositionList", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"loadValues", ",", "loadTimes"}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"oneTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"newColumn", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"#2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ";;", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
         RowBox[{"Table", "[", 
          RowBox[{"#1", ",", 
