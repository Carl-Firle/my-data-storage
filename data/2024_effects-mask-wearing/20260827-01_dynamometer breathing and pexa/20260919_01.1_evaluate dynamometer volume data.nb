Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "evaluateVolumeDynamometerData", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"evaluateVolumeDynamometerData", "[", "\[IndentingNewLine]", 
     RowBox[{
     "mode_String", "\[IndentingNewLine]", ",", "nameProtocol_String", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
      "namePexaData_String", "\[IndentingNewLine]", ",", 
      "namePexaProtocol_String", "\[IndentingNewLine]", "\[IndentingNewLine]",
       ",", "nameDynamometerData_String", "\[IndentingNewLine]", ",", 
      "nameDynamometerProtocol1_String", "\[IndentingNewLine]", ",", 
      "positionDynamometerCSV1_Integer", "\[IndentingNewLine]", ",", 
      "nameDynamometerProtocol2_String", "\[IndentingNewLine]", ",", 
      "positionDynamometerCSV2_Integer"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"import", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"dProtocolImport", "[", "nameProtocol", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dPexaImport", "[", 
         RowBox[{"namePexaData", ",", "namePexaProtocol"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"dDynamometerImport", "[", 
         RowBox[{
         "nameDynamometerData", ",", "nameDynamometerProtocol1", ",", 
          "positionDynamometerCSV1"}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"dDynamometerImport", "[", 
         RowBox[{
         "nameDynamometerData", ",", "nameDynamometerProtocol2", ",", 
          "positionDynamometerCSV2"}], "]"}], " ", ";", "\[IndentingNewLine]",
         "\[IndentingNewLine]", 
        RowBox[{"createTabular", "[", "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "generate", " ", "raw", " ", "data", " ", "plot", " ", "with", " ", 
          "pexa", " ", "airflow", " ", "data", " ", "and", " ", "dynamometer",
           " ", "data"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"graphicCorrectionFactor", "=", "20"}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"oneTableTab", "=", 
         RowBox[{"TransformColumns", "[", 
          RowBox[{"oneTableTab", ",", 
           RowBox[{"\"\<pexa_Inhale Exhale Airflow [ml/(20 s)]\>\"", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{
               "QuantityMagnitude", "[", 
                "#\"pexa_Inhale Exhale Airflow [ml/s]\"", "]"}], "/", "20"}], 
              "&"}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"plotRangeX", "=", 
         RowBox[{"MinMax", "[", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{"oneTableTab", ",", 
             RowBox[{
              RowBox[{"!", 
               RowBox[{
               "MissingQ", "[", "#\"pexa_Inhale Exhale Airflow [ml/s]\"", 
                "]"}]}], "&"}]}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], 
          "]"}]}], ";", "\n", "\n", 
        RowBox[{"measurementPlot", "=", 
         RowBox[{"ListLinePlot", "[", 
          RowBox[{
           RowBox[{"oneTableTab", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                RowBox[{
                "nameDynamometerProtocol1", "<>", "\"\< force [N]\>\""}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                RowBox[{
                "nameDynamometerProtocol2", "<>", "\"\< force [N]\>\""}]}], 
               "}"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<elapsed time [s]\>\"", 
                ",", "\"\<pexa_Inhale Exhale Airflow [ml/(20 s)]\>\""}], 
               "}"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
           RowBox[{"PlotLegends", "->", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{
              "nameDynamometerProtocol1", " ", "<>", 
               " ", "\"\< force [N]\>\""}], ",", 
              RowBox[{
              "nameDynamometerProtocol2", " ", "<>", 
               " ", "\"\< force [N]\>\""}], 
              ",", "\"\<pexa_Inhale Exhale Airflow [ml/(20 s)]\>\""}], 
             "}"}]}], "\[IndentingNewLine]", ",", 
           RowBox[{"FrameLabel", "->", 
            RowBox[{"{", 
             
             RowBox[{"\"\<elapsed time [s]\>\"", ",", 
              " ", "\"\<mixed scale, see legends\>\""}], "}"}]}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
           RowBox[{"myPlotSequence", "[", "]"}], ",", 
           RowBox[{"PlotRange", "->", 
            RowBox[{"{", 
             RowBox[{"plotRangeX", ",", "All"}], "}"}]}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"myFigAppend", "[", 
         RowBox[{"measurementPlot", ",", "\"\<001\>\"", ",", 
          RowBox[{
          "id", "<>", "\"\< plot pexa airflow and dynamometer data\>\""}], ",",
           "300", ",", "True"}], "]"}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "calculate", " ", "breathing", " ", "volume", " ", "from", " ", 
          "airflow"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"dExtr", "=", 
         RowBox[{"Select", "[", 
          RowBox[{"oneTableTab", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
             "MissingQ", "[", "#\"pexa_Inhale Exhale Airflow [ml/s]\"", "]"}],
              "===", "False"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"timeFlowData", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"myNormalColumnTab", "[", 
             RowBox[{"dExtr", ",", "\"\<elapsed time [s]\>\""}], "]"}], ",", 
            RowBox[{"myNormalColumnTab", "[", 
             RowBox[{
             "dExtr", ",", "\"\<pexa_Inhale Exhale Airflow [ml/s]\>\""}], 
             "]"}]}], "}"}], "]"}]}], ";", "\n", "\[IndentingNewLine]", 
        "\[IndentingNewLine]", 
        RowBox[{"ClearAll", "[", "airflowToVolume", "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"airflowToVolume", "[", "data_", "]"}], ":=", 
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "time", ",", "flow", ",", "deltaT", ",", "deltaV", ",", 
             "volume"}], "}"}], "\[IndentingNewLine]", ",", 
           RowBox[{
            RowBox[{"time", "=", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"flow", "=", 
             RowBox[{"data", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"deltaT", "=", 
             RowBox[{"Differences", "[", "time", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"deltaV", "=", 
             RowBox[{
              RowBox[{"-", "deltaT"}], "*", 
              RowBox[{"MovingAverage", "[", 
               RowBox[{"flow", ",", "2"}], "]"}]}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"volume", "=", 
             RowBox[{"Prepend", "[", 
              RowBox[{
               RowBox[{"Accumulate", "[", "deltaV", "]"}], ",", "0"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"time", ",", "volume"}], "}"}], "]"}]}]}], "]"}]}], ";",
         "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"volumeData", "=", 
         RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"rawVolume", "=", 
         RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "find", " ", "positive", " ", "to", " ", "negative", " ", "sign", " ",
           "changes", " ", "and", " ", "replace", " ", "with", " ", 
          "averaged", " ", "value"}], " ", "=", "  ", 
         RowBox[{
          RowBox[{
          "linear", " ", "interpolation", " ", "of", " ", "the", " ", "exact",
            " ", "zero", " ", "crossing", " ", "at", " ", "the", " ", "end"}],
           "-", 
          RowBox[{"expiratory", " ", "phase"}]}]}], "*)"}], ";", 
       RowBox[{"endExpiration", "=", 
        RowBox[{"Cases", "[", 
         RowBox[{
          RowBox[{"Partition", "[", 
           RowBox[{"timeFlowData", ",", "2", ",", "1"}], "]"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"t1_", ",", "q1_"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"t2_", ",", "q2_"}], "}"}]}], "}"}], "/;", 
            RowBox[{
             RowBox[{"q1", ">", "0"}], "&&", 
             RowBox[{"q2", "<", "0"}]}]}], ":>", 
           RowBox[{"t1", "-", 
            RowBox[{"q1", " ", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"t2", "-", "t1"}], ")"}], "/", 
              RowBox[{"(", 
               RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "interpolate", " ", "raw", " ", "volume", " ", "data", " ", "and", " ",
           "baseline", " ", "points", " ", "from", " ", "end"}], "-", 
         RowBox[{"expiratory", " ", "phase"}]}], "*)"}], "\n", 
       RowBox[{"volumeFunction", "=", 
        RowBox[{"Interpolation", "[", 
         RowBox[{"rawVolume", ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\n", 
       RowBox[{"baselinePoints", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#", ",", 
            RowBox[{"volumeFunction", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
         "endExpiration"}]}], ";", "\n", 
       RowBox[{"baseline", "=", 
        RowBox[{"Interpolation", "[", 
         RowBox[{"baselinePoints", ",", 
          RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "correct", " ", "volume", " ", "with", " ", "interpolated", " ", 
          "baseline", " ", "data"}], " ", "->", " ", 
         RowBox[{"v", " ", "-", " ", 
          RowBox[{"baseline", "[", "t", "]"}]}]}], "*)"}], 
       RowBox[{"correctedVolume", "=", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"rawVolume", ",", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"First", "[", "baselinePoints", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", 
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "<=", 
             RowBox[{
              RowBox[{"Last", "[", "baselinePoints", "]"}], "[", 
              RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}], "/.", " ", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"t_", ",", "v_"}], "}"}], ":>", 
          RowBox[{"{", 
           RowBox[{"t", ",", 
            RowBox[{"v", "-", 
             RowBox[{"baseline", "[", "t", "]"}]}]}], "}"}]}]}]}], ";", "\n", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", "plots", "*)"}], "\[IndentingNewLine]", 
       RowBox[{"volumePlot", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{"correctedVolume", ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"myPlotSequence", "[", "]"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<elapsed time [s]\>\"", ",", 
             " ", "\"\<volume [ml]\>\""}], "}"}]}]}], "]"}]}], ";", "\n", 
       "\[IndentingNewLine]", 
       RowBox[{"plotVolumeRawVsCorrected", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rawVolume", ",", "correctedVolume"}], "}"}], ",", 
          RowBox[{"PlotRange", "->", "All"}], ",", 
          RowBox[{"myPlotSequence", "[", "]"}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<elapsed time [s]\>\"", ",", 
             " ", "\"\<volume [ml]\>\""}], "}"}]}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"myFigAppend", "[", 
        RowBox[{"{", 
         RowBox[{"plotVolumeRawVsCorrected", ",", "\"\<002\>\"", ",", 
          RowBox[{
          "id", "<>", "\"\< plot interpolated volume baseline corrected vs \
raw volume data\>\""}], ",", "300", ",", "True"}], "}"}], "]"}], ";", 
       "\[IndentingNewLine]", "\n", 
       RowBox[{"plotVolumeRawBaselineCorr", "=", 
        RowBox[{"Show", "[", 
         RowBox[{
          RowBox[{"ListLinePlot", "[", 
           RowBox[{"rawVolume", ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", 
            RowBox[{"FrameLabel", "->", 
             RowBox[{"{", 
              
              RowBox[{"\"\<elapsed time [s]\>\"", ",", 
               " ", "\"\<volume [ml]\>\""}], "}"}]}]}], "]"}], ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{"baselinePoints", ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"PointSize", "[", "Large", "]"}], ",", "Red"}], 
              "]"}]}]}], "]"}], ",", 
          RowBox[{"Plot", "[", 
           RowBox[{
            RowBox[{"baseline", "[", "t", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"t", ",", 
              RowBox[{
               RowBox[{"First", "[", "baselinePoints", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", 
              RowBox[{
               RowBox[{"Last", "[", "baselinePoints", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "}"}]}], "]"}], ",", 
          RowBox[{"myPlotSequence", "[", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"myFigAppend", "[", 
        RowBox[{"{", 
         RowBox[{"plotVolumeRawBaselineCorr", ",", "\"\<003\>\"", ",", 
          RowBox[{
          "id", "<>", "\"\< plot raw volume with baseline detection\>\""}], ",",
           "300", ",", "True"}], "}"}], "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "calculate", " ", "volume", " ", "of", " ", "breathing", " ", "for", " ",
          "the", " ", "original", " ", "dataset", " ", "but", " ", "with", " ",
          "interpolation", " ", "function"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"dExtrVolume", "=", 
        RowBox[{"TransformColumns", "[", 
         RowBox[{"dExtr", ",", 
          RowBox[{"\"\<volume breathing [ml]\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Quantity", "[", 
              RowBox[{
               RowBox[{"volumeFunction", "[", 
                RowBox[{"QuantityMagnitude", "[", 
                 RowBox[{"#", "[", "\"\<elapsed time [s]\>\"", "]"}], "]"}], 
                "]"}], ",", "\"\<Milliliters\>\""}], "]"}], "&"}], ")"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "calculate", " ", "the", " ", "baseline", " ", "corrected", " ", 
         "breathing", " ", "volume", " ", "with", " ", "the", " ", "original",
          " ", 
         RowBox[{"dataset", ".", " ", "The"}], " ", "data", " ", "extract", " ",
          "has", " ", "to", " ", "size", " ", "the", " ", "baseline", " ", 
         "interpolation", " ", 
         RowBox[{"range", "."}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"dExtrVolume", "=", 
        RowBox[{"TransformColumns", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"dExtrVolume", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"First", "[", "baselinePoints", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<=", 
              RowBox[{"QuantityMagnitude", "[", 
               RowBox[{"#", "[", "\"\<elapsed time [s]\>\"", "]"}], "]"}], "<=", 
              RowBox[{
               RowBox[{"Last", "[", "baselinePoints", "]"}], "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}], ",", 
          
          RowBox[{"\"\<volume breathing baseline corrected [ml]\>\"", "->", 
           "\[IndentingNewLine]", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"Quantity", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"QuantityMagnitude", "[", 
                 RowBox[{"#", "[", "\"\<volume breathing [ml]\>\"", "]"}], 
                 "]"}], "-", 
                RowBox[{"baseline", "[", 
                 RowBox[{"QuantityMagnitude", "[", 
                  RowBox[{"#", "[", "\"\<elapsed time [s]\>\"", "]"}], "]"}], 
                 "]"}]}], ",", "\"\<Milliliters\>\""}], "]"}], "&"}], 
            ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"dExtrVolume", "=", 
        RowBox[{"TransformColumns", "[", 
         RowBox[{"dExtrVolume", ",", 
          RowBox[{"\"\<volume breathing baseline corrected [100 ml]\>\"", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
             "#\"volume breathing baseline corrected [ml]\"", "/", "100"}], 
             "&"}], ")"}]}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"volumePlotCorrectedScaled", "=", 
        RowBox[{"ListLinePlot", "[", 
         RowBox[{
          RowBox[{"dExtrVolume", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<elapsed time [s]\>\"", 
             ",", "\"\<volume breathing baseline corrected [100 ml]\>\""}], 
            "}"}]}], ",", 
          RowBox[{"myPlotSequence", "[", "]"}], ",", 
          RowBox[{"PlotStyle", "->", "Black"}], ",", 
          RowBox[{"PlotLegends", "->", 
           RowBox[{
           "{", "\"\<volume breathing baseline corrected [100 ml]\>\"", 
            "}"}]}], ",", 
          RowBox[{"FrameLabel", "->", 
           RowBox[{"{", 
            
            RowBox[{"\"\<elapsed time [s]\>\"", ",", 
             " ", "\"\<mixed scale, see legend\>\""}], "}"}]}]}], "]"}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"plotVolumeCorDynamometer", "=", 
        RowBox[{"Show", "[", "\[IndentingNewLine]", 
         RowBox[{"volumePlotCorrectedScaled", "\[IndentingNewLine]", ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"dExtrVolume", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                 RowBox[{
                 "nameDynamometerProtocol1", "<>", "\"\< force [N]\>\""}]}], 
                "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                 RowBox[{
                 "nameDynamometerProtocol2", "<>", "\"\< force [N]\>\""}]}], 
                "}"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "nameDynamometerProtocol1", " ", "<>", 
                " ", "\"\< force [N]\>\""}], ",", 
               RowBox[{
               "nameDynamometerProtocol2", " ", "<>", 
                " ", "\"\< force [N]\>\""}]}], "}"}]}], "\[IndentingNewLine]",
             "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
            RowBox[{"myPlotSequence", "[", "]"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{"plotRangeX", ",", "All"}], "}"}]}]}], "]"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
          RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"myFigAppend", "[", 
        RowBox[{"{", 
         RowBox[{"plotVolumeCorDynamometer", ",", "\"\<004\>\"", ",", 
          RowBox[{
          "id", "<>", "\"\< plot dynamometer data and volume breathing \
baseline corrected\>\""}], ",", "300", ",", "True"}], "}"}], "]"}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "find", " ", "peaks", " ", "and", " ", "determine", " ", "breathing", 
         " ", "phase"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxPosition", "=", 
        RowBox[{"FindPeaks", "[", 
         RowBox[{
          RowBox[{"dExtrVolume", "[", 
           RowBox[{"[", 
            RowBox[{
            "All", ",", "\"\<volume breathing baseline corrected [ml]\>\""}], 
            "]"}], "]"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"maxPosition", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "/=", "100"}], ";", 
       RowBox[{"(*", 
        RowBox[{
        "for", " ", "comprehensive", " ", "graphical", " ", "output"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"maxPositionTime", "=", 
        RowBox[{
         RowBox[{"dExtrVolume", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"maxPosition", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxPosition", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"maxPositionTime", ",", 
           RowBox[{"maxPosition", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"minPosition", "=", 
        RowBox[{"FindPeaks", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "1"}], "*", 
           RowBox[{"dExtrVolume", "[", 
            RowBox[{"[", 
             RowBox[{
             "All", ",", "\"\<volume breathing baseline corrected [ml]\>\""}],
              "]"}], "]"}]}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"minPosition", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "/=", "100"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
        "for", " ", "comprehensive", " ", "graphical", " ", "output"}], 
        "*)"}], "\[IndentingNewLine]", 
       RowBox[{"minPositionTime", "=", 
        RowBox[{
         RowBox[{"dExtrVolume", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"minPosition", "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"minPosition", "=", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"minPositionTime", ",", 
           RowBox[{
            RowBox[{"-", "1"}], "*", 
            RowBox[{"minPosition", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}]}], "}"}], "]"}]}], ";",
        "\[IndentingNewLine]", "\n", 
       RowBox[{"plotVolumeCorDynamometerMinMax", "=", 
        RowBox[{"Show", "[", "\[IndentingNewLine]", 
         RowBox[{"volumePlotCorrectedScaled", "\[IndentingNewLine]", ",", 
          RowBox[{"ListLinePlot", "[", 
           RowBox[{
            RowBox[{"dExtrVolume", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                 RowBox[{
                 "nameDynamometerProtocol1", "<>", "\"\< force [N]\>\""}]}], 
                "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                 RowBox[{
                 "nameDynamometerProtocol2", "<>", "\"\< force [N]\>\""}]}], 
                "}"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
            RowBox[{"PlotLegends", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{
               "nameDynamometerProtocol1", " ", "<>", 
                " ", "\"\< force [N]\>\""}], ",", 
               RowBox[{
               "nameDynamometerProtocol2", " ", "<>", 
                " ", "\"\< force [N]\>\""}]}], "}"}]}], ",", 
            RowBox[{"myPlotSequence", "[", "]"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{"plotRangeX", ",", "All"}], "}"}]}]}], "]"}], 
          "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"maxPosition", ",", "minPosition"}], "}"}], ",", 
            RowBox[{"myPlotSequence", "[", "]"}], ",", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"PointSize", "[", "Large", "]"}], ",", 
               "StandardGreen"}], "]"}]}]}], "]"}], "\[IndentingNewLine]", 
          "\[IndentingNewLine]", ",", 
          RowBox[{"PlotRange", "->", "All"}]}], "\[IndentingNewLine]", 
         "\[IndentingNewLine]", "]"}]}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"myFigAppend", "[", 
        RowBox[{"{", 
         RowBox[{"plotVolumeCorDynamometerMinMax", ",", "\"\<00\.085\>\"", ",", 
          RowBox[{
          "id", "<>", "\"\< plot dynamometer data and volume breathing \
baseline corrected with minima/maxima\>\""}], ",", "300", ",", "True"}], 
         "}"}], "]"}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "breathing", " ", "cycle", " ", "shall", " ", "allways", " ", 
          "start", " ", "with", " ", "minimum"}], " ", "=", " ", 
         RowBox[{"inspiration", " ", "phase"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"maxPosition", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
          RowBox[{"minPosition", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
         RowBox[{"Delete", "[", 
          RowBox[{"maxPosition", ",", "1"}], "]"}], ",", "Nothing"}], "]"}], ";",
        "\n", "     ", 
       RowBox[{"n", "=", 
        RowBox[{"Min", "[", 
         RowBox[{
          RowBox[{"Length", "[", "maxPosition", "]"}], ",", 
          RowBox[{"Length", "[", "minPosition", "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", " ", "\n", "     ", 
       RowBox[{"maxPosition", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"maxPosition", ",", "n"}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{"equalize", " ", "length"}], "*)"}], "\n", "     ", 
       RowBox[{"minPosition", "=", 
        RowBox[{"Take", "[", 
         RowBox[{"minPosition", ",", "n"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"determine", " ", "minimum"}], "-", 
         RowBox[{
         "minimum", " ", "ranges", " ", "and", " ", "calculate", " ", 
          "target", " ", "parameters"}]}], "*)"}], "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"minMinRanges", "=", 
        RowBox[{"Transpose", "/@", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Most", "[", "minPosition", "]"}], ",", 
            RowBox[{"Rest", "[", "minPosition", "]"}]}], "}"}], "]"}]}]}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"windowbefore", "=", "2"}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "seconds", " ", "before", " ", "and", " ", "after", " ", "min"}], "-", 
         RowBox[{"min", " ", "of", " ", "volume", " ", "curve"}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"windowafter", "=", "1.5"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", 
       RowBox[{"ClearAll", "[", "extractBreathPhase", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"extractBreathPhase", "[", "l_List", "]"}], ":=", 
        RowBox[{"Select", "[", 
         RowBox[{"dExtrVolume", ",", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"l", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "-", 
               RowBox[{"Quantity", "[", 
                RowBox[{"windowbefore", ",", "\"\<Seconds\>\""}], "]"}]}], 
              ")"}], "<=", "#\"elapsed time [s]\"", "<=", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"l", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "+", 
               RowBox[{"Quantity", "[", 
                RowBox[{"windowafter", ",", "\"\<Seconds\>\""}], "]"}]}], 
              ")"}]}], "&"}], ")"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       "\n", "       ", 
       RowBox[{"breathPhases", "=", 
        RowBox[{"extractBreathPhase", "/@", 
         RowBox[{"minMinRanges", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
