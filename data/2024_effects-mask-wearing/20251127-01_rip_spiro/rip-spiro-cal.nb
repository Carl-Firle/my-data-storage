Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataForAnalysisCropped", "=", "dataForAnalysis"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"lbound", ",", "ubound"}], "}"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"dataForAnalysisCropped", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2", ",", "3"}], "]"}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"{", 
           RowBox[{"1", ",", 
            RowBox[{"-", "1"}]}], "}"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dataForAnalysisCropped", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "2", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"dataForAnalysisCropped", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2", ",", "1"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"lbound", "<", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<", "ubound"}], "&"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dataForAnalysisCropped", "[", 
        RowBox[{"[", 
         RowBox[{"i", ",", "2", ",", "2"}], "]"}], "]"}], "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         RowBox[{"dataForAnalysisCropped", "[", 
          RowBox[{"[", 
           RowBox[{"i", ",", "2", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"lbound", "<", 
           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "<", "ubound"}], "&"}]}], "]"}]}],
       ";"}], "\[IndentingNewLine]", ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "@", "dataForAnalysisCropped"}]}], "}"}]}], "]"}], 
   ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"breathDetect", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"breathDetect", "[", "l_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "peaks", ",", "peaksLow", ",", "xdiffs", ",", "linesDiff", ",", 
       "xDiffSeconds", ",", "yDiffVolume"}], "}"}], "\[IndentingNewLine]", ",",
      "\[IndentingNewLine]", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"values", "=", 
         RowBox[{"l", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "i"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"peaks", "=", 
         RowBox[{"FindPeaks", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"l", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "i"}], "]"}], "]"}], "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "6"}], "]"}]}], ";",
         "\n", 
        RowBox[{"peaksLow", "=", 
         RowBox[{"FindPeaks", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"l", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "i"}], "]"}], "]"}], "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "6"}], "]"}]}], 
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"peaks", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
           RowBox[{"peaksLow", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"peaks", "=", 
           RowBox[{"Delete", "[", 
            RowBox[{"peaks", ",", "1"}], "]"}]}], ",", "Nothing"}], "]"}], 
        " ", ";", 
        RowBox[{"(*", 
         RowBox[{
         "start", " ", "with", " ", "first", " ", "inspiration", " ", 
          "volume"}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"hier", " ", "noch", " ", "pr\[UDoubleDot]fen"}], ",", " ", 
          RowBox[{
          "ob", " ", "der", " ", "Peak", " ", "im", " ", "Zeitverlauf", " ", 
           "auch", " ", "nahe", " ", "am", " ", "Peak", " ", "der", " ", 
           "Spirometrie", " ", 
           RowBox[{
            RowBox[{"liegt", "!!"}], "!"}], " ", "10", 
           RowBox[{"%", "?"}]}]}], "*)"}], "\[IndentingNewLine]", 
        RowBox[{"peaksLow", "=", 
         RowBox[{"peaksLow", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"peaksLow", "=", 
         RowBox[{"peaksLow", "[", 
          RowBox[{"[", 
           RowBox[{"1", ";;", 
            RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"xdiffs", "=", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"Round", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], 
             "/@", "peaksLow"}], ",", 
            RowBox[{
             RowBox[{
              RowBox[{"values", "[", 
               RowBox[{"[", 
                RowBox[{"Round", "[", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], 
             "/@", "peaks"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"linesDiff", "=", 
         RowBox[{"Line", "/@", "xdiffs"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"xDiffSeconds", "=", 
         RowBox[{"-", 
          RowBox[{"Subtract", "@@@", 
           RowBox[{"xdiffs", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}]}]}], ";", 
        " ", 
        RowBox[{"(*", 
         RowBox[{"inspiratory", " ", "breathing", " ", "duration"}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{"yDiffVolume", "=", 
         RowBox[{"-", 
          RowBox[{"Subtract", "@@@", 
           RowBox[{"xdiffs", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}]}]}], " ", ";", 
        RowBox[{"(*", 
         RowBox[{"inspiratory", " ", "breathing", " ", "volume"}], "*)"}], 
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Tabular", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"xDiffSeconds", ",", "yDiffVolume"}], "}"}], "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<\[CapitalDelta] insp. time [s]\>\"", 
              ",", "\"\<\[CapitalDelta] force [N]\>\""}], "}"}]}], "]"}], 
          "\[IndentingNewLine]", ",", 
          RowBox[{"Show", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"values", ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"values", "[", 
                   RowBox[{"[", 
                    RowBox[{"Round", "@", "#"}], "]"}], "]"}], "&"}], "/@", 
                 " ", 
                 RowBox[{"peaks", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
                RowBox[{
                 RowBox[{
                  RowBox[{"values", "[", 
                   RowBox[{"[", 
                    RowBox[{"Round", "@", "#"}], "]"}], "]"}], "&"}], "/@", 
                 " ", 
                 RowBox[{"peaksLow", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
              RowBox[{"PlotLabel", "->", 
               RowBox[{"myStyle", "@", 
                RowBox[{"l", "[", 
                 RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"PlotLegends", "->", 
               RowBox[{"{", "\"\<RIP\>\"", "}"}]}], ",", 
              RowBox[{"FrameLabel", "->", 
               RowBox[{"{", 
                RowBox[{"\"\<time [s]\>\"", ",", "\"\<force [N]\>\""}], 
                "}"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"Joined", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"True", ",", "False", ",", "False"}], "}"}]}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"PlotStyle", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"Automatic", ",", 
                 RowBox[{"PointSize", "[", ".02", "]"}], ",", 
                 RowBox[{"PointSize", "[", ".02", "]"}], ",", 
                 RowBox[{"PlotRange", "->", "All"}]}], "}"}]}], ",", 
              RowBox[{"ImageSize", "->", "Large"}], ",", 
              RowBox[{"Frame", "->", "True"}], ",", 
              RowBox[{"PlotRange", "->", "All"}], ",", 
              RowBox[{"myFrameStyle", "[", "]"}], ",", 
              RowBox[{"myFrameTickStyle", "[", "]"}]}], "\[IndentingNewLine]",
              "]"}], "\[IndentingNewLine]", ",", 
            RowBox[{
             RowBox[{
              RowBox[{"Graphics", "[", 
               RowBox[{"{", 
                RowBox[{"Thick", ",", "Red", ",", "#"}], "}"}], "]"}], "&"}], 
             "/@", "linesDiff"}]}], "\[IndentingNewLine]", "]"}]}], 
         "\[IndentingNewLine]", "}"}]}], "\[IndentingNewLine]", ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}]}], "}"}]}], "]"}]}], 
    "\[IndentingNewLine]", "\[IndentingNewLine]", "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ripBreaths", "=", 
  RowBox[{
  "breathDetect", "/@", 
   "dataForAnalysisCropped"}]}], "\[IndentingNewLine]"}], "Input",
