            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"d", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"d", "[", 
