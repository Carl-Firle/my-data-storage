Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "extractInspPhase", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"extractInspPhase", "[", "l_List", "]"}], ":=", 
    RowBox[{"Select", "[", 
     RowBox[{"dExtrVolume", ",", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"l", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "-", 
           RowBox[{"Quantity", "[", 
            RowBox[{".5", ",", "\"\<Seconds\>\""}], "]"}]}], ")"}], "<=", 
         "#\"elapsed time [s]\"", "<=", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"l", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "+", 
           RowBox[{"Quantity", "[", 
            RowBox[{".5", ",", "\"\<Seconds\>\""}], "]"}]}], ")"}]}], "&"}], 
       ")"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "minMaxWithTime", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minMaxWithTime", "[", 
     RowBox[{"data_", ",", "col_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "x", "}"}], ",", 
      RowBox[{
       RowBox[{"x", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"MinimalBy", "[", 
           RowBox[{"data", ",", 
            RowBox[{
             RowBox[{"#", "[", "col", "]"}], "&"}]}], "]"}], ",", 
          RowBox[{"MaximalBy", "[", 
           RowBox[{"data", ",", 
            RowBox[{
             RowBox[{"#", "[", "col", "]"}], "&"}]}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Tabular", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\"\<Min\>\"", ",", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"x", "[", 
               RowBox[{"1", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], ",", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"x", "[", 
               RowBox[{"1", ",", "col"}], "]"}], "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\"\<Max\>\"", ",", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"x", "[", 
               RowBox[{"2", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], ",", 
             RowBox[{"QuantityMagnitude", "[", 
              RowBox[{"x", "[", 
               RowBox[{"2", ",", "col"}], "]"}], "]"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          
          RowBox[{"\"\<type\>\"", ",", "\"\<elapsed time [s]\>\"", 
           ",", "\"\<value\>\""}], "}"}]}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
