            {
             RowBox[{
              RowBox[{"myHolmBonferroni", "[", 
               RowBox[{"pVals_List", ",", 
                RowBox[{"alpha_", ":", "0.05`"}]}], "]"}], ":=", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                 "m", ",", "sorted", ",", "idx", ",", "pSorted", ",", "crit", 
                  ",", "decisions", ",", "rejections"}], "}"}], ",", 
                RowBox[{
                 RowBox[{"m", "=", 
                  RowBox[{"Length", "[", "pVals", "]"}]}], ";", 
                 RowBox[{"sorted", "=", 
                  RowBox[{"SortBy", "[", 
                   RowBox[{
                    TemplateBox[{
                    RowBox[{"{", 
                    RowBox[{"pVals", ",", 
                    RowBox[{"Range", "[", "m", "]"}]}], "}"}]},
                    "Transpose"], ",", "First"}], "]"}]}], ";", 
                 RowBox[{"pSorted", "=", 
                  RowBox[{"sorted", "\[LeftDoubleBracket]", 
                   RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}]}], ";", 
                 RowBox[{"idx", "=", 
                  RowBox[{"sorted", "\[LeftDoubleBracket]", 
                   RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}]}], ";", 
                 RowBox[{"crit", "=", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    FractionBox["alpha", 
                    RowBox[{"m", "+", "1", "-", "k"}]], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1", ",", "m"}], "}"}]}], "]"}]}], ";", 
                 RowBox[{"decisions", "=", 
                  RowBox[{"Table", "[", 
                   RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    "pSorted", "\[LeftDoubleBracket]", "k", 
                    "\[RightDoubleBracket]"}], "\[LessEqual]", 
                    RowBox[{
                    "crit", "\[LeftDoubleBracket]", "k", 
                    "\[RightDoubleBracket]"}]}], ",", "True", ",", "False"}], 
                    "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"k", ",", "1", ",", "m"}], "}"}]}], "]"}]}], ";", 
                 RowBox[{"decisions", "=", 
                  RowBox[{"decisions", "/.", "\[VeryThinSpace]", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"a___", ",", "False", ",", "___"}], "}"}], "\[RuleDelayed]", 
                    RowBox[{"{", 
                    RowBox[{"a", ",", "False", ",", 
                    RowBox[{"Sequence", "@@", 
                    RowBox[{"ConstantArray", "[", 
                    RowBox[{"False", ",", 
                    RowBox[{"m", "-", 
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "a", "}"}], "]"}], "-", "1"}]}], "]"}]}]}], 
                    "}"}]}]}]}], ";", 
                 RowBox[{"rejections", "=", 
                  RowBox[{"ConstantArray", "[", 
                   RowBox[{"False", ",", "m"}], "]"}]}], ";", 
                 RowBox[{"Do", "[", 
                  RowBox[{
                   RowBox[{
                    RowBox[{"rejections", "\[LeftDoubleBracket]", 
                    RowBox[{
                    "idx", "\[LeftDoubleBracket]", "k", 
                    "\[RightDoubleBracket]"}], "\[RightDoubleBracket]"}], "=", 
                    RowBox[{
                    "decisions", "\[LeftDoubleBracket]", "k", 
                    "\[RightDoubleBracket]"}]}], ",", 
                   RowBox[{"{", 
                    RowBox[{"k", ",", "1", ",", "m"}], "}"}]}], "]"}], ";", 
                 RowBox[{"Association", "[", 
                  RowBox[{
                   
                   RowBox[{"\<\"RejectionsBoolean\"\>", "\[Rule]", 
                    "rejections"}], ",", 
                   RowBox[{"\<\"RejectedIndices\"\>", "\[Rule]", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"Position", "[", 
                    RowBox[{"rejections", ",", "True"}], "]"}], "]"}]}], ",", 
                   RowBox[{"\<\"SortedTable\"\>", "\[Rule]", 
                    RowBox[{"Table", "[", 
                    RowBox[{
