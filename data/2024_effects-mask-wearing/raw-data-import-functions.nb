       RowBox[{"Import", "[", 
        RowBox[{"urlHead", " ", "~~", "filename"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dProtocol", "=", 
       RowBox[{"StringReplace", "[", 
        RowBox[{"dProtocol", ",", "stringFix"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"protocol", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "->", 
          RowBox[{"Quantity", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"ToExpression", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}], "]"}], " ", "/", "1000."}], 
            ",", "\"\<Seconds\>\""}], "]"}]}], "&"}], "/@", 
        RowBox[{"myStringSplit", "[", 
         RowBox[{"dProtocol", ",", 
          RowBox[{"{", 
           RowBox[{"\"\< --- \>\"", ",", "\"\< :: \>\""}], "}"}]}], "]"}]}]}],
       "\[IndentingNewLine]", ";", 
      RowBox[{"protocol", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "->", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "-", 
           RowBox[{"Min", "[", 
            RowBox[{"Values", "@", "protocol"}], "]"}]}]}], "&"}], "/@", 
        "protocol"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"\"\<_start\>\"", "|", "\"\<_end\>\""}]}], "]"}], "&"}]}],
         "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{"startEndTimes", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{"ToLowerCase", "/@", 
        RowBox[{"startEndTimes", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      ";", 
      RowBox[{"var", "=", 
       RowBox[{"Union", "[", 
        RowBox[{"ToLowerCase", "/@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"StringReplace", "[", 
             RowBox[{"#", ",", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\"\<_start\>\"", "->", "\"\<\>\""}], ",", 
                RowBox[{"\"\<_end\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}], 
            "&"}], "/@", 
           RowBox[{"startEndTimes", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"startEndTimes", ",", 
         RowBox[{
          RowBox[{"strContQ", "[", 
           RowBox[{"#", ",", "var"}], "]"}], "&"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GatherBy", "[", 
          RowBox[{"#", ",", "First"}], "]"}], "&"}], "/@", 
        "startEndTimes"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
       RowBox[{"startEndTimes", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "All", ",", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"timeline", "=", 
       RowBox[{"Range", "[", 
        RowBox[{"0", ",", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Values", "[", 
               RowBox[{
               "protocolSelect", "[", "\"\<end of protocol\>\"", "]"}], "]"}],
               "-", 
