           RowBox[{
            RowBox[{"Keys", "[", "#", "]"}], ",", "varName"}], "]"}], "&"}]}],
         "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"check", "==", 
         RowBox[{"{", "}"}]}], ",", "Nothing", ",", "check"}], "]"}]}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
