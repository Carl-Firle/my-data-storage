Cell[BoxData[{
 RowBox[{"synchronize", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"synchronize", "[", 
    RowBox[{
    "l_List", ",", "timePosition_Integer", ",", "maxTime_", ",", 
     "timeStamp_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "l2", "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"l2", "=", "l"}], "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{"l2", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "timePosition"}], "]"}], "]"}], "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Round", "[", 
           RowBox[{
            RowBox[{"timeStamp", "-", 
             RowBox[{"Quantity", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"maxTime", "-", "#"}], ")"}], 
               ",", "\"\<Seconds\>\""}], "]"}]}], ",", ".5"}], "]"}], "&"}], ",", 
         RowBox[{"l2", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "timePosition"}], "]"}], "]"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", "l2"}]}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"protocolSelect", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"protocolSelect", "[", "varName_String", "]"}], ":=", 
   RowBox[{"Select", "[", 
    RowBox[{"protocol", ",", 
     RowBox[{
      RowBox[{"StringContainsQ", "[", 
       RowBox[{
        RowBox[{"Keys", "[", "#", "]"}], ",", "varName"}], "]"}], "&"}]}], 
    "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"oneTableAppend", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"oneTableAppend", "[", 
    RowBox[{"varNamesList_List", ",", "lValues_List"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"replList", ",", "temp", ",", "temp2"}], "}"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"varNames", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{"Append", "[", 
         RowBox[{"varNames", ",", "varNamesList"}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"FirstPosition", "[", 
