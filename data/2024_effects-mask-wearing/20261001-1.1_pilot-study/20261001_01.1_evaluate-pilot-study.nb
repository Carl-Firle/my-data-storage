Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
   "there", " ", "is", " ", "no", " ", "normal", " ", "distribution", " ", 
    "and", " ", "Bland"}], "-", 
   RowBox[{"Altmann", " ", "has", " ", "to", " ", "be", " ", "adapted"}]}], 
  "*)"}]], "Input",
 CellChangeTimes->{{3.9999141965595913`*^9, 
  3.9999142216719856`*^9}},ExpressionUUID->"1a0a5d6e-42f7-7a49-a3d1-\
cb99bceec9d5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"measuredVolumes", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}], "&"}], "/@", 
    "dvalPred"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"predictedVolumes", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspPredVol\>\"", "]"}], "&"}], "/@",
      "dvalPred"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"errors", "=", 
   RowBox[{"measuredVolumes", "-", "predictedVolumes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanVolumes", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"measuredVolumes", "+", "predictedVolumes"}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"baData", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"meanVolumes", ",", "errors"}], "}"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bias", "=", 
    RowBox[{"Median", "[", "errors", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{"loaLower", ",", "loaUpper"}], "}"}], "=", 
    RowBox[{"Quantile", "[", 
     RowBox[{"errors", ",", 
      RowBox[{"{", 
       RowBox[{"0.025", ",", "0.975"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<bias [mL]\>\"", "->", "bias"}], ",", 
    RowBox[{"\"\<lower empirical percentile limit [mL]\>\"", "->", 
     "loaLower"}], ",", 
    RowBox[{"\"\<upper empirical percentile limit [mL]\>\"", "->", 
     "loaUpper"}]}], "|>"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Labeled", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"ListPlot", "[", 
    RowBox[{"baData", ",", 
     RowBox[{"Frame", "->", "True"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<mean of measured and predicted volume [mL]\>\"", 
        ",", "\"\<volume difference (measured \[Minus] predicted) [mL]\>\""}],
        "}"}]}], ",", 
     RowBox[{"PlotStyle", "->", 
      RowBox[{"Directive", "[", 
       RowBox[{"Blue", ",", 
        RowBox[{"PointSize", "[", "0.016", "]"}]}], "]"}]}], ",", 
     RowBox[{"PlotRange", "->", 
      RowBox[{"{", 
       RowBox[{"All", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Min", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"errors", ",", "loaLower"}], "]"}], "]"}], ",", 
          RowBox[{"Max", "[", 
           RowBox[{"Append", "[", 
            RowBox[{"errors", ",", "loaUpper"}], "]"}], "]"}]}], "}"}]}], 
       "}"}]}], ",", 
     RowBox[{"PlotRangePadding", "->", 
      RowBox[{"Scaled", "[", "0.06", "]"}]}], ",", 
     RowBox[{"Prolog", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Directive", "[", 
         RowBox[{
          RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", "Dashed"}], "]"}], ",", 
        RowBox[{"InfiniteLine", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "loaLower"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "loaLower"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"InfiniteLine", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "loaUpper"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "loaUpper"}], "}"}]}], "}"}], "]"}], ",", 
        RowBox[{"Directive", "[", 
         RowBox[{"Orange", ",", "Thick"}], "]"}], ",", 
        RowBox[{"InfiniteLine", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "bias"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", "bias"}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",", 
     RowBox[{"myPlotSequence", "[", "]"}]}], "]"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", ",", 
   RowBox[{"Style", "[", 
    RowBox[{"\"\<\\nBland-Altman-Plot with median difference and empirical \
2.5th and 97.5th percentiles as descriptive limits\>\"", ",", "Bold", ",", 
     RowBox[{"TextAlignment", "->", "Center"}], ",", "myFontSize", ",", 
     "myFontStandard"}], "]"}]}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"caption", 
  "=", "\"\<Bland\[Dash]Altman plot of measured versus predicted volume. The \
solid line indicates zero difference, the orange dashed line the median \
difference, and the grey dashed lines the empirical 2.5th and 97.5th \
percentiles of the prediction errors as descriptive limits.\>\""}]}], "Input",
 CellChangeTimes->{{3.999444893806507*^9, 3.999444893806507*^9}, {
  3.9999142266061153`*^9, 3.999914247979164*^9}, {3.9999142887826576`*^9, 
