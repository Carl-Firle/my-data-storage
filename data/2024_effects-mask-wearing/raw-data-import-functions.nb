         RowBox[{"\"\<\\n\>\"", ",", "\"\<;\>\""}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"varNamesMS30", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"#1", "~~", "\"\< [\>\"", "~~", "#2", "~~", "\"\<]\>\""}],
             ",", 
            RowBox[{"\"\<\\\"\>\"", "->", "\"\<\>\""}]}], "]"}], "&"}], "@@@", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
