Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"errors", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}], "-", 
        RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspPredVol\>\"", "]"}]}], 
       ")"}], "&"}], "/@", "dvalPred"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"bias", "=", 
  RowBox[{"Mean", "[", "errors", "]"}]}], "\n", 
 RowBox[{"mae", "=", 
  RowBox[{"Mean", "[", 
   RowBox[{"Abs", "[", "errors", "]"}], "]"}]}], "\n", 
 RowBox[{
  RowBox[{"rmse", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"Mean", "[", 
     RowBox[{"errors", "^", "2"}], "]"}], "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Histogram", "[", 
  RowBox[{"errors", ",", "Automatic", ",", "\"\<Probability\>\"", ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<prediction error (\!\(\*SubscriptBox[\(volume\), \(measured\
\)]\) \[Minus] \!\(\*SubscriptBox[\(volume\), \(predicted\)]\)) [ml]\>\"", 
      ",", "\"\<fraction of breahts\>\""}], "}"}]}], ",", 
   RowBox[{"myPlotSequence", "[", "]"}]}], "]"}]}], "Input",
