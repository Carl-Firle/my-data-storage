Cell[BoxData[{
 RowBox[{"dPexaImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dPexaImport", "[", 
   RowBox[{"filename_String", ",", "deviceName_String"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dPexa", ",", "dPexaVarNames", ",", "dPexaValues", ",", "dPexaSync", ",",
       "dPexaSyncMeans", ",", "dPexaErrors", ",", "newColumn"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"dPexa", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"urlHead", " ", "~~", "filename"}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"dPexa", "=", 
        RowBox[{"myStringSplit", "[", 
         RowBox[{"dPexa", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<\\n\>\"", ",", "\"\<\\t\>\""}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"dPexaVarNames", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"deviceName", "~~", "\"\<_\>\"", "~~", "#"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"StringReplace", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\"\<counts/l\>\"", "->", "\"\<1/L\>\""}], ",", 
                 RowBox[{"\"\<[n]\>\"", "->", "\"\<[1]\>\""}], ",", 
                 RowBox[{"\"\<\[Degree]C\>\"", "->", "\"\<Celsius\>\""}], ",", 
                 RowBox[{"\"\<%\>\"", "->", "\"\<percent\>\""}], ",", 
                 
                 RowBox[{"\"\<Volume ml]\>\"", 
                  "->", "\"\<Volume [ml]\>\""}]}], "}"}]}], "]"}], "&"}], "/@", 
            RowBox[{"dPexa", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"dPexaValues", "=", 
        RowBox[{"dPexa", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "15"}]}], "]"}], "]"}]}], ";"}], " ", 
      RowBox[{"(*", 
       RowBox[{
       "the", " ", "last", " ", "14", " ", "values", " ", "are", " ", 
        "descriptive", " ", "data"}], "*)"}], "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{"dPexaValues", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"myUnixTime", "[", "#", "]"}], "&"}], "/@", 
        RowBox[{"dPexaValues", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      ";", 
      RowBox[{"dPexaSync", "=", 
       RowBox[{"synchronize", "[", 
        RowBox[{"dPexaValues", ",", "1", ",", "deviceName"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dPexaSyncMeans", "=", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"ToExpression", "[", "#", "]"}], "/.", " ", 
             RowBox[{"Null", "->", "Nothing"}]}], "]"}], "&"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "#", "]"}], "&"}], "/@", 
             RowBox[{"GatherBy", "[", 
              RowBox[{"dPexaSync", ",", "First"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"2", ";;", 
              RowBox[{"-", "1"}]}]}], "]"}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], " ", "/.", 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Mean", "[", 
            RowBox[{"{", "}"}], "]"}], ")"}], "->", "\"\<n.a.\>\""}], 
         ")"}]}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"dPexaSyncMeans", "=", 
       RowBox[{"myFlatten", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Union", "@", 
             RowBox[{"dPexaSync", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
            "dPexaSyncMeans"}], "}"}], "]"}], ",", "1"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dPexaErrors", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"NumberQ", "[", "#", "]"}], ",", 
            RowBox[{"Around", "[", 
             RowBox[{"#", ",", 
              RowBox[{"#", ".1"}]}], "]"}], ",", "#"}], "]"}], "&"}], ",", 
         RowBox[{"dPexaSyncMeans", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"4", ";;", "20"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dPexaSyncMeans", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"4", ";;", "20"}]}], "]"}], "]"}], "=", "dPexaErrors"}], 
      ";"}], 
