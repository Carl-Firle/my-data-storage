 RowBox[{
  RowBox[{"QuantilePlot", "[", 
   RowBox[{"errors", ",", 
    RowBox[{"Frame", "->", "True"}], ",", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Theoretical normal quantile [mL]\>\"", 
