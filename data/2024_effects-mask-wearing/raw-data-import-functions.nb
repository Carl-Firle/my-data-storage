       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newColumn", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"positionInTimeline", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ";;", 
              RowBox[{"-", "1"}]}], "]"}], "]"}]}], "&"}], "/@", 
         "dPexaSyncMeans"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTable", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oneTable", ",", 
          RowBox[{"Transpose", "[", "newColumn", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
