         "\[IndentingNewLine]", 
         RowBox[{"errors", "=", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}], "-", 
