 RowBox[{
  RowBox[{
   RowBox[{"measurementCountdownImport", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "temp", ",", "tempStart", ",", "tempEnd", ",", "countdownTime", ",", 
       "rangePositions", ",", "newColumn"}], "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         StyleBox["protocol",
          FontColor->GrayLevel[0]], ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"{", "\"\<countdown\>\"", "}"}]}], "]"}], "&"}]}], 
        "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"tempStart", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"StringSplit", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<***\>\""}], "]"}], "->", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", "temp"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"tempEnd", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"StringReplace", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"\"\<start\>\"", "->", "\"\<end\>\""}]}], "]"}], "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "+", 
             RowBox[{"(", 
              RowBox[{"countdownTime", "=", 
               RowBox[{"Quantity", "[", 
                RowBox[{
                 RowBox[{"ToExpression", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], 
                 ",", "\"\<Minutes\>\""}], "]"}]}], ")"}]}], ")"}]}], ")"}], 
         "&"}], "/@", "tempStart"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tempStart", ",", "tempEnd"}], "}"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"rangePositions", "=", 
       RowBox[{"Map", "[", 
        RowBox[{"positionInTimeline", ",", 
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"newColumn", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"\"\<n.a.\>\"", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"oneTable", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"newColumn", "[", 
           RowBox[{"[", 
            RowBox[{"#1", ";;", "#2"}], "]"}], "]"}], "=", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#2", "-", "#1"}], ")"}], "/", "2"}], ",", "0", ",", 
            RowBox[{"-", ".5"}]}], "]"}]}], ")"}], "&"}], "@@@", 
       "rangePositions"}], "\[IndentingNewLine]", ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"varNames", ",", "\"\<countdown [s]\>\""}], "]"}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"oneTable", ",", "newColumn"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
