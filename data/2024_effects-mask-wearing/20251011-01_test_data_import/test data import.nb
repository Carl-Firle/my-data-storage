Cell[BoxData[{
 RowBox[{"doorTimesImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"doorTimesImport", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "temp", ",", "timepoints", ",", "orderPositions", ",", "doorTimes", ",",
        "rangePositions", ",", "newColumn"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<door\>\""}], "]"}], 
          "&"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"temp", ",", 
         RowBox[{"\"\<door_cabin_exit_closed\>\"", "\[Rule]", 
          RowBox[{"(", 
           RowBox[{
