Cell[BoxData[{
 RowBox[{"dMS30Import", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dMS30Import", "[", 
   RowBox[{"filename_String", ",", "deviceName_String"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"dMS30", ",", "varNamesMS30", ",", "dMS30sync"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"dMS30", "=", " ", 
      RowBox[{"Import", "[", 
       RowBox[{"urlHead", "~~", "filename"}], "]"}]}], "\[IndentingNewLine]", 
     ";", 
     RowBox[{"dMS30", "=", 
      RowBox[{"myStringSplit", "[", 
       RowBox[{"dMS30", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<\\n\>\"", ",", "\"\<;\>\""}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"varNamesMS30", "=", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"#1", "~~", "\"\< [\>\"", "~~", "#2", "~~", "\"\<]\>\""}],
             ",", 
            RowBox[{"\"\<\\\"\>\"", "->", "\"\<\>\""}]}], "]"}], "&"}], "@@@", 
         RowBox[{"ReplacePart", "[", 
          RowBox[{
           RowBox[{"Transpose", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"dMS30", "[", 
               RowBox[{"[", "3", "]"}], "]"}], ",", 
              RowBox[{"dMS30", "[", 
               RowBox[{"[", "5", "]"}], "]"}]}], "}"}], "]"}], ",", 
           RowBox[{"2", "->", 
            RowBox[{"{", 
             RowBox[{"\"\<time\>\"", ",", "\"\<hh:mm:ss\>\""}], "}"}]}]}], 
          "]"}]}], ")"}], "[", 
       RowBox[{"[", 
        RowBox[{"3", ";;", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"dMS30", "=", " ", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"UnixTime", "[", 
            RowBox[{"FromDateString", "[", 
             RowBox[{
              RowBox[{"StringReplace", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "~~", " ", "\"\< \>\"", " ",
                  "~~", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<\\\"\>\"", "->", "\"\<\>\""}]}], "]"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Day\>\"", ",", "\"\<Month\>\"", 
                ",", "\"\<Year\>\"", ",", "\"\<Time\>\""}], "}"}]}], "]"}], 
            "]"}], ",", 
           RowBox[{"ToExpression", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"StringReplace", "[", 
               RowBox[{"#", ",", 
                RowBox[{"\"\<,\>\"", "->", "\"\<.\>\""}]}], "]"}], "&"}], "/@", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"3", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}]}], "}"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"dMS30", "[", 
        RowBox[{"[", 
         RowBox[{"9", ";;", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"dMS30sync", "=", 
      RowBox[{"synchronize", "[", 
       RowBox[{"dMS30", ",", "1", ",", "deviceName"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"oneTable", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"dMS30sync", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newColumn", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"positionInTimeline", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "&"}], "/@", 
           "dMS30sync"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "!=", "\"\<NotFound\>\""}], 
           "&"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTable", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oneTable", ",", 
          RowBox[{"Transpose", "[", "newColumn", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", "varNamesMS30"}], "]"}], "\[IndentingNewLine]",
      ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9726236964148254`*^9, 3.9726238665759163`*^9}, 
