Cell[CellGroupData[{

Cell["regression RIP signal and lung volume", "Section",
 CellChangeTimes->{{3.9523328095680523`*^9, 3.9523328134640102`*^9}, {
  3.955438809305113*^9, 
  3.955438809808115*^9}},ExpressionUUID->"7dbbe75c-e32a-e84d-8cf9-\
1a3e97a75fdd"],

Cell[TextData[{
 "Cave :\nthe raw data is flawed for \[OpenCurlyDoubleQuote]pexa_Exhale \
Airflow [ml/s]\[CloseCurlyDoubleQuote] since the filter was not insert in the \
Pexa instrument. I.e., the values for this variable are constantly too high \
and have to be corrected\n\n\n",
 Cell[BoxData[{
  RowBox[{
   RowBox[{
    RowBox[{"dPexaSyncMeans", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", "2"}], "]"}], "]"}], "=", 
    RowBox[{
     RowBox[{"dPexaSyncMeans", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], "-", "200"}]}], " "}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "there", " ", "is", " ", "a", " ", "constant", " ", "circuit", " ", 
     "flow", " ", "in", " ", "PExA", " ", "with", " ", "250", " ", 
     RowBox[{"ml", "/", 
      RowBox[{"s", ".", "That"}]}], " ", "shifts", " ", "the", 
     " ", "\"\<Exhale Airflow\>\"", " ", "but", " ", "not", " ", "the", " ", 
     RowBox[{"\"\<Inhale Airflow\>\"", "!"}], " ", "The", " ", "shift", " ", 
     "is", " ", "constantly", " ", "200", " ", 
     RowBox[{"ml", "/", "s"}], " ", "not", " ", "250", " ", 
     RowBox[{"ml", "/", 
      RowBox[{"s", "."}]}]}], ")"}]}]}], "Input",
  CellChangeTimes->{{3.9969041292114563`*^9, 3.9969041292114563`*^9}},
  ExpressionUUID->"de9aa7d1-668b-b049-93e3-4ec604e3d0b2"]
}], "Text",
 CellChangeTimes->{{3.9969040720102787`*^9, 3.9969041451994343`*^9}, {
  3.9969041759508*^9, 3.9969041965083046`*^9}},
 Background->RGBColor[
  0.93, 0.27, 0.27, 
   0.33],ExpressionUUID->"9da1e65d-15e2-2b4b-ae27-5735780d01c7"],

