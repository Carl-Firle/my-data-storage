Cell[BoxData[{
 RowBox[{"dRIPImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dRIPImport", "[", 
   RowBox[{"filename_String", ",", "deviceName_String", ",", 
    RowBox[{"positionForce_Integer", ":", "2"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "dRIP", "}"}], "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"dRIP", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"urlHead", "~~", "filename"}], "]"}]}], "\[IndentingNewLine]", 
     ";", 
     RowBox[{"dRIP", "=", 
      RowBox[{"dRIP", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "positionForce"}], "}"}]}], "]"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"dRIP", " ", "=", 
      RowBox[{"synchronize", "[", 
       RowBox[{"dRIP", ",", "1", ",", "deviceName"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"dRIP", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"Mean", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"dRIP", ",", "First"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"oneTable", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"dRIP", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newColumn", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"positionInTimeline", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "&"}], "/@", "dRIP"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "!=", "\"\<NotFound\>\""}], 
           "&"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTable", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oneTable", ",", 
          RowBox[{"Transpose", "[", "newColumn", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", "\"\<RIP force ribcage [N]\>\""}], "]"}], 
     "\[IndentingNewLine]", ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9726240619910393`*^9, 3.9726240659542027`*^9}, 
   3.972624107382208*^9, {3.9728353386892796`*^9, 3.9728353602607536`*^9}, {
   3.972835468880781*^9, 3.9728354689832573`*^9}, {3.972835522391802*^9, 
   3.972835593203356*^9}, {3.972917658863264*^9, 3.9729176772097225`*^9}, {
   3.972917712452841*^9, 3.972917713517639*^9}},
 CellLabel->"In[78]:=",ExpressionUUID->"c350515d-5347-4e4e-ac17-445c4880aaad"],

Cell[BoxData[{
 RowBox[{"dPexaImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dPexaImport", "[", 
   RowBox[{"filename_String", ",", "deviceName_String"}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dPexa", ",", "dPexaVarNames", ",", "dPexaValues", ",", "dPexaSync", ",",
       "dPexaSyncMeans", ",", "dPexaErrors", ",", "newColumn"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"dPexa", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"urlHead", " ", "~~", "filename"}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"dPexa", "=", 
        RowBox[{"myStringSplit", "[", 
         RowBox[{"dPexa", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<\\n\>\"", ",", "\"\<\\t\>\""}], "}"}]}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"dPexaVarNames", "=", 
        RowBox[{
         RowBox[{
          RowBox[{"deviceName", "~~", "\"\<_\>\"", "~~", "#"}], "&"}], "/@", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"StringReplace", "[", 
              RowBox[{"#", ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"\"\<counts/l\>\"", "->", "\"\<1/L\>\""}], ",", 
                 RowBox[{"\"\<[n]\>\"", "->", "\"\<[1]\>\""}], ",", 
                 RowBox[{"\"\<\[Degree]C\>\"", "->", "\"\<Celsius\>\""}], ",", 
                 RowBox[{"\"\<%\>\"", "->", "\"\<percent\>\""}], ",", 
                 
                 RowBox[{"\"\<Volume ml]\>\"", 
                  "->", "\"\<Volume [ml]\>\""}]}], "}"}]}], "]"}], "&"}], "/@", 
            RowBox[{"dPexa", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"2", ";;", 
            RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"dPexaValues", "=", 
        RowBox[{"dPexa", "[", 
         RowBox[{"[", 
          RowBox[{"2", ";;", 
           RowBox[{"-", "15"}]}], "]"}], "]"}]}], ";"}], " ", 
      RowBox[{"(*", 
       RowBox[{
       "the", " ", "last", " ", "14", " ", "values", " ", "are", " ", 
        "descriptive", " ", "data"}], "*)"}], "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{"dPexaValues", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"myUnixTime", "[", "#", "]"}], "&"}], "/@", 
        RowBox[{"dPexaValues", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "\[IndentingNewLine]", 
      ";", 
      RowBox[{"dPexaSync", "=", 
       RowBox[{"synchronize", "[", 
        RowBox[{"dPexaValues", ",", "1", ",", "deviceName"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dPexaSyncMeans", "=", 
       RowBox[{
        RowBox[{"Map", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Mean", "[", 
            RowBox[{
             RowBox[{"ToExpression", "[", "#", "]"}], "/.", " ", 
             RowBox[{"Null", "->", "Nothing"}]}], "]"}], "&"}], ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"Transpose", "[", "#", "]"}], "&"}], "/@", 
             RowBox[{"GatherBy", "[", 
              RowBox[{"dPexaSync", ",", "First"}], "]"}]}], ")"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", 
             RowBox[{"2", ";;", 
              RowBox[{"-", "1"}]}]}], "]"}], "]"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], " ", "/.", 
        RowBox[{"(", " ", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"Mean", "[", 
            RowBox[{"{", "}"}], "]"}], ")"}], "->", "\"\<n.a.\>\""}], 
         ")"}]}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"dPexaSyncMeans", "=", 
       RowBox[{"myFlatten", "[", 
        RowBox[{
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Union", "@", 
             RowBox[{"dPexaSync", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
            "dPexaSyncMeans"}], "}"}], "]"}], ",", "1"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"dPexaErrors", "=", 
       RowBox[{"Map", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"NumberQ", "[", "#", "]"}], ",", 
            RowBox[{"Around", "[", 
             RowBox[{"#", ",", 
              RowBox[{"#", ".1"}]}], "]"}], ",", "#"}], "]"}], "&"}], ",", 
         RowBox[{"dPexaSyncMeans", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", 
            RowBox[{"3", ";;", "19"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dPexaSyncMeans", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"3", ";;", "19"}]}], "]"}], "]"}], "=", "dPexaErrors"}], 
      ";"}], 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"error", " ", "of", " ", "10", " ", "%"}], ",", " ", 
       RowBox[{"compare", " ", 
        GraphicsBox[
         TagBox[RasterBox[CompressedData["
