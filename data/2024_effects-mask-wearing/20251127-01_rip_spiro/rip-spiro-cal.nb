Cell[BoxData[{
 RowBox[{"breathDetect", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"breathDetect", "[", "l_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "peaks", ",", "peaksLow", ",", "xdiffs", ",", "linesDiff", ",", 
       "xDiffSeconds", ",", "yDiffVolume"}], "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"values", "=", 
       RowBox[{"l", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"peaks", "=", 
       RowBox[{"FindPeaks", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "3"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "10"}], "]"}]}], ";",
       "\n", 
      RowBox[{"peaksLow", "=", 
       RowBox[{"FindPeaks", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"l", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "3"}], "]"}], "]"}], "[", 
           RowBox[{"[", 
            RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "10"}], "]"}]}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"peaks", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
         RowBox[{"peaksLow", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{"peaks", "=", 
         RowBox[{"Delete", "[", 
          RowBox[{"peaks", ",", "1"}], "]"}]}], ",", "Nothing"}], "]"}], " ", 
      ";", 
      RowBox[{"(*", 
       RowBox[{
