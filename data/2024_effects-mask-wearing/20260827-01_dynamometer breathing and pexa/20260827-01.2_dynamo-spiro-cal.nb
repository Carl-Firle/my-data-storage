Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "breathing", " ", "cycle", " ", "shall", " ", "allways", " ", "start", " ",
      "with", " ", "minimum"}], " ", "=", " ", 
    RowBox[{"inspiration", " ", "phase"}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"maxPosition", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
      RowBox[{"minPosition", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"Delete", "[", 
      RowBox[{"maxPosition", ",", "1"}], "]"}], ",", "Nothing"}], "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"Length", "@", "maxPosition"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "@", "minPosition"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"n", "=", 
     RowBox[{"Min", "[", 
      RowBox[{
       RowBox[{"Length", "[", "maxPosition", "]"}], ",", 
       RowBox[{"Length", "[", "minPosition", "]"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxPosition", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"maxPosition", ",", "n"}], "]"}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"equalize", " ", "length"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"minPosition", "=", 
     RowBox[{"Take", "[", 
      RowBox[{"minPosition", ",", "n"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"Length", "@", "maxPosition"}], "\[IndentingNewLine]", 
   RowBox[{"Length", "@", "minPosition"}]}]}]], "Input",
