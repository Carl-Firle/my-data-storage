                "All", ",", "\"\<volume breathing baseline corrected \
[ml]\>\""}], "]"}], "]"}], ",", "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"maxPosition", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "2"}], "]"}], "]"}], "/=", "100"}], ";", 
           RowBox[{"(*", 
