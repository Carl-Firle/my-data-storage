Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "evaluateVolumeDynamometerData", "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"evaluateVolumeDynamometerData", "[", "\[IndentingNewLine]", 
     RowBox[{
     "nameProtocol_String", "\[IndentingNewLine]", "\[IndentingNewLine]", ",",
       "namePexaData_String", "\[IndentingNewLine]", ",", 
      "namePexaProtocol_String", "\[IndentingNewLine]", "\[IndentingNewLine]",
       ",", "nameDynamometerData_String", "\[IndentingNewLine]", 
      "\[IndentingNewLine]", ",", "nameDynamometerProtocol1_String", 
      "\[IndentingNewLine]", ",", "positionDynamometerCSV1_Integer", 
      "\[IndentingNewLine]", ",", "nameDynamometer1Spec_String", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
      "nameDynamometerProtocol2_String", "\[IndentingNewLine]", ",", 
      "positionDynamometerCSV2_Integer", "\[IndentingNewLine]", ",", 
      "nameDynamometer2Spec_String"}], "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "}"}], "\[IndentingNewLine]", ",", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"import", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"dProtocolImport", "[", "nameProtocol", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dPexaImport", "[", 
        RowBox[{"namePexaData", ",", "namePexaProtocol"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"dDynamometerImport", "[", 
        RowBox[{
        "nameDynamometerData", ",", "nameDynamometerProtocol1", ",", 
         "positionDynamometerCSV1", ",", "nameDynamometer1Spec"}], "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"dDynamometerImport", "[", 
        RowBox[{
        "nameDynamometerData", ",", "nameDynamometerProtocol2", ",", 
         "positionDynamometerCSV2", ",", "nameDynamometer2Spec"}], "]"}], " ",
        ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"createTabular", "[", "]"}], ";", "\[IndentingNewLine]", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"loop", "[", "oneTableTabExtractInput_Tabular", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", "oneTableTabExtract", "}"}], ",", 
          "\[IndentingNewLine]", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "generate", " ", "raw", " ", "data", " ", "plot", " ", "with", " ",
             "pexa", " ", "airflow", " ", "data", " ", "and", " ", 
            "dynamometer", " ", "data"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{
            RowBox[{"graphicCorrectionFactor", "=", "20"}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"oneTableTabExtract", "=", 
             RowBox[{"TransformColumns", "[", 
              RowBox[{"oneTableTabExtractInput", ",", 
               
               RowBox[{"\"\<spiro_pexa_Inhale Exhale Airflow [ml/(20 s)]\>\"",
                 "->", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "QuantityMagnitude", "[", 
                    "#\"spiro_pexa_Inhale Exhale Airflow [ml/s]\"", "]"}], "/",
                    "20"}], "&"}], ")"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"plotRangeX", "=", 
             RowBox[{"MinMax", "[", 
              RowBox[{
               RowBox[{"Select", "[", 
                RowBox[{"oneTableTabExtract", ",", 
                 RowBox[{
                  RowBox[{"!", 
                   RowBox[{
                   "MissingQ", "[", 
                    "#\"spiro_pexa_Inhale Exhale Airflow [ml/s]\"", "]"}]}], 
                  "&"}]}], "]"}], "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], 
               "]"}], "]"}]}], ";", "\n", "\n", 
            RowBox[{"measurementPlot", "=", 
             RowBox[{"ListLinePlot", "[", 
              RowBox[{
               RowBox[{"oneTableTabExtract", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                    RowBox[{
                    "nameDynamometerProtocol1", "<>", "\"\<_\>\"", "<>", 
                    "nameDynamometer1Spec", "<>", "\"\< force [N]\>\""}]}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                    RowBox[{
                    "nameDynamometerProtocol2", "<>", "\"\<_\>\"", "<>", 
                    "nameDynamometer2Spec", "<>", "\"\< force [N]\>\""}]}], 
                   "}"}], ",", 
                  RowBox[{"{", 
                   
                   RowBox[{"\"\<elapsed time [s]\>\"", 
                    ",", "\"\<spiro_pexa_Inhale Exhale Airflow [ml/(20 \
s)]\>\""}], "}"}]}], "}"}]}], "\[IndentingNewLine]", ",", 
               RowBox[{"PlotLegends", "->", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{
                  "nameDynamometerProtocol1", "<>", "\"\<_\>\"", "<>", 
                   "nameDynamometer1Spec", "<>", "\"\< force [N]\>\""}], ",", 
                  RowBox[{
                  "nameDynamometerProtocol2", "<>", "\"\<_\>\"", "<>", 
                   "nameDynamometer2Spec", "<>", " ", "\"\< force [N]\>\""}], 
                  ",", "\"\<spiro_pexa_Inhale Exhale Airflow [ml/(20 \
s)]\>\""}], "}"}]}], "\[IndentingNewLine]", ",", 
               RowBox[{"FrameLabel", "->", 
                RowBox[{"{", 
                 
                 RowBox[{"\"\<elapsed time [s]\>\"", ",", 
                  " ", "\"\<mixed scale, see legends\>\""}], "}"}]}], 
               "\[IndentingNewLine]", "\[IndentingNewLine]", ",", 
               RowBox[{"myPlotSequence", "[", "]"}], ",", 
               RowBox[{"PlotRange", "->", 
                RowBox[{"{", 
                 RowBox[{"plotRangeX", ",", "All"}], "}"}]}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"myFigAppend", "[", 
             RowBox[{"measurementPlot", ",", "\"\<001\>\"", ",", 
              RowBox[{
              "id", "<>", "\"\< \>\"", "<>", "mode", 
               "<>", "\"\< plot pexa airflow and dynamometer data\>\""}], ",",
               "300", ",", "True"}], "]"}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
             "calculate", " ", "breathing", " ", "volume", " ", "from", " ", 
              "airflow"}], "*)"}], "\[IndentingNewLine]", 
            RowBox[{"dExtr", "=", 
             RowBox[{"Select", "[", 
              RowBox[{"oneTableTabExtract", ",", 
               RowBox[{
                RowBox[{
                 RowBox[{
                 "MissingQ", "[", 
                  "#\"spiro_pexa_Inhale Exhale Airflow [ml/s]\"", "]"}], "===",
                  "False"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"timeFlowData", "=", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"myNormalColumnTab", "[", 
                 RowBox[{"dExtr", ",", "\"\<elapsed time [s]\>\""}], "]"}], ",", 
                RowBox[{"myNormalColumnTab", "[", 
                 RowBox[{
                 "dExtr", 
                  ",", "\"\<spiro_pexa_Inhale Exhale Airflow [ml/s]\>\""}], 
                 "]"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
            RowBox[{"ClearAll", "[", "airflowToVolume", "]"}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"airflowToVolume", "[", "data_", "]"}], ":=", 
             RowBox[{"Module", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                "time", ",", "flow", ",", "deltaT", ",", "deltaV", ",", 
                 "volume"}], "}"}], "\[IndentingNewLine]", ",", 
               RowBox[{
                RowBox[{"time", "=", 
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"flow", "=", 
                 RowBox[{"data", "[", 
                  RowBox[{"[", 
                   RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"deltaT", "=", 
                 RowBox[{"Differences", "[", "time", "]"}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"deltaV", "=", 
                 RowBox[{
                  RowBox[{"-", "deltaT"}], "*", 
                  RowBox[{"MovingAverage", "[", 
                   RowBox[{"flow", ",", "2"}], "]"}]}]}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"volume", "=", 
                 RowBox[{"Prepend", "[", 
                  RowBox[{
                   RowBox[{"Accumulate", "[", "deltaV", "]"}], ",", "0"}], 
                  "]"}]}], ";", "\[IndentingNewLine]", 
                RowBox[{"Transpose", "[", 
                 RowBox[{"{", 
                  RowBox[{"time", ",", "volume"}], "}"}], "]"}]}]}], "]"}]}], 
            ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
            "\[IndentingNewLine]", 
            RowBox[{"volumeData", "=", 
             RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"rawVolume", "=", 
             RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";"}], 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "find", " ", "positive", " ", "to", " ", "negative", " ", "sign",
               " ", "changes", " ", "and", " ", "replace", " ", "with", " ", 
              "averaged", " ", "value"}], " ", "=", "  ", 
             RowBox[{
              RowBox[{
              "linear", " ", "interpolation", " ", "of", " ", "the", " ", 
               "exact", " ", "zero", " ", "crossing", " ", "at", " ", "the", " ",
                "end"}], "-", 
              RowBox[{"expiratory", " ", "phase"}]}]}], "*)"}], ";", 
           RowBox[{"endExpiration", "=", 
            RowBox[{"Cases", "[", 
             RowBox[{
              RowBox[{"Partition", "[", 
               RowBox[{"timeFlowData", ",", "2", ",", "1"}], "]"}], ",", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"t1_", ",", "q1_"}], "}"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"t2_", ",", "q2_"}], "}"}]}], "}"}], "/;", 
                RowBox[{
                 RowBox[{"q1", ">", "0"}], "&&", 
                 RowBox[{"q2", "<", "0"}]}]}], ":>", 
               RowBox[{"t1", "-", 
                RowBox[{"q1", " ", 
                 RowBox[{
                  RowBox[{"(", 
                   RowBox[{"t2", "-", "t1"}], ")"}], "/", 
                  RowBox[{"(", 
                   RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", "\n", 
           RowBox[{"(*", 
            RowBox[{
             RowBox[{
             "interpolate", " ", "raw", " ", "volume", " ", "data", " ", 
              "and", " ", "baseline", " ", "points", " ", "from", " ", 
              "end"}], "-", 
             RowBox[{"expiratory", " ", "phase"}]}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"volumeFunction", "=", 
            RowBox[{"Interpolation", "[", 
             RowBox[{"rawVolume", ",", 
              RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\n", 
           RowBox[{"baselinePoints", "=", 
            RowBox[{
             RowBox[{
              RowBox[{"{", 
               RowBox[{"#", ",", 
                RowBox[{"volumeFunction", "[", "#", "]"}]}], "}"}], "&"}], "/@",
              "endExpiration"}]}], ";", "\n", 
           RowBox[{"baseline", "=", 
            RowBox[{"Interpolation", "[", 
             RowBox[{"baselinePoints", ",", 
              RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";", 
