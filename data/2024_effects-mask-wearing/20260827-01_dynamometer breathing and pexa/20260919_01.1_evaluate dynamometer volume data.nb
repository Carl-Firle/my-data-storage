                 RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
              RowBox[{"valueFactor", " ", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"d", "[", 
                  RowBox[{"[", 
                   RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
                 RowBox[{"d", "[", 
                  RowBox[{"[", 
                   RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}]}], ",", 
              RowBox[{
               RowBox[{"d", "[", 
                RowBox[{"[", 
                 RowBox[{"3", ",", "1"}], "]"}], "]"}], "-", 
               RowBox[{"d", "[", 
                RowBox[{"[", 
                 RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
