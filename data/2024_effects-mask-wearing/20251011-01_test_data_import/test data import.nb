      "\[IndentingNewLine]", ";", 
      RowBox[{"loadValues", "=", 
       RowBox[{"temp", "[", 
        RowBox[{"[", 
         RowBox[{"1", ",", "All", ",", "1", ",", "1", ",", "2"}], "]"}], 
        "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"loadTimes", "=", 
       RowBox[{"Map", "[", 
        RowBox[{"positionInTimeline", ",", 
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"valueRangePositionList", "=", 
