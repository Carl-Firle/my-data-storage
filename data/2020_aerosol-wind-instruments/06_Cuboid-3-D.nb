Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\[IndentingNewLine]", 
    RowBox[{
    "ConnectMeshRegions", ",", "\[IndentingNewLine]", "DisplayMeshRegions"}], 
    "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"ConnectMeshRegions", "[", 
      RowBox[{"mregs_", ",", "repair_"}], "]"}], " ", ":=", " ", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"c", ",", "d", ",", "e", ",", "p"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"Flatten", "[", "mregs", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"TrueQ", "[", "repair", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"c", " ", "=", " ", 
           RowBox[{"RepairMesh", "/@", "c"}]}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"d", " ", "=", " ", 
         RowBox[{"Min", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"RegionDimension", "/@", "c"}], ")"}], "-", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"Head", "/@", "c"}], ")"}], "/.", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"BoundaryMeshRegion", "\[Rule]", "1"}], ",", 
               RowBox[{"MeshRegion", "\[Rule]", "0"}]}], "}"}]}], ")"}]}], 
          "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"e", "=", 
               RowBox[{"MeshCoordinates", "[", "#", "]"}]}], ",", 
              RowBox[{"First", "/@", 
               RowBox[{"MeshCells", "[", 
                RowBox[{"#", ",", "d"}], "]"}]}], ",", 
              RowBox[{"-", 
               RowBox[{"Length", "[", "e", "]"}]}]}], "}"}], "&"}], ",", 
           "c"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"SortBy", "[", 
          RowBox[{"c", ",", "Last"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"c", " ", "=", " ", 
         RowBox[{"Transpose", "[", "c", "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"Min", "/@", 
             RowBox[{"c", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "===", 
           RowBox[{"{", "1", "}"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"e", "=", 
               RowBox[{"-", 
                RowBox[{"c", "[", 
                 RowBox[{"[", "3", "]"}], "]"}]}]}], ")"}], "===", 
             RowBox[{"(", 
              RowBox[{"Max", "/@", 
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"c", "[", 
               RowBox[{"[", "2", "]"}], "]"}], " ", "+=", " ", 
              RowBox[{"FoldList", "[", 
               RowBox[{"Plus", ",", "0", ",", 
                RowBox[{"Drop", "[", 
                 RowBox[{"e", ",", 
                  RowBox[{"-", "1"}]}], "]"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"c", " ", "=", " ", 
              RowBox[{"Join", "@@@", 
               RowBox[{"Take", "[", 
                RowBox[{"c", ",", "2"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"p", " ", "=", " ", 
              RowBox[{"DeleteDuplicates", "[", 
               RowBox[{"c", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"AllPositions", "[", 
               RowBox[{
                RowBox[{"c", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], ",", "p"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"If", "[", 
                  RowBox[{
                   RowBox[{"IntegerQ", "[", "#", "]"}], ",", 
                   RowBox[{"{", "#", "}"}], ",", "#"}], "]"}], "&"}], ",", 
                "e"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"Transpose", "[", 
               RowBox[{"{", 
                RowBox[{"e", ",", 
                 RowBox[{"List", "/@", 
                  RowBox[{"Range", "[", 
                   RowBox[{"Length", "[", "e", "]"}], "]"}]}]}], "}"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"Map", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"ReplacePart", "[", 
                  RowBox[{"#", ",", 
                   RowBox[{"Complement", "@@", "#"}], ",", "1"}], "]"}], 
                 "&"}], ",", "e"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"Select", "[", 
               RowBox[{"e", ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], "\[NotEqual]", 
                   RowBox[{"{", "}"}]}], ")"}], "&"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"Flatten", "[", 
               RowBox[{"Map", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Outer", "[", 
                   RowBox[{"Rule", ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "1", "]"}], "]"}], ",", 
                    RowBox[{"#", "[", 
                    RowBox[{"[", "2", "]"}], "]"}], ",", "1"}], "]"}], "&"}], 
                 ",", "e"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"Dispatch", "[", "e", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{
               RowBox[{"c", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "/.", "e"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"e", " ", "=", " ", 
              RowBox[{"DeleteDuplicates", "[", "e", "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"d", " ", "=", " ", 
              RowBox[{"d", "/.", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"1", "\[Rule]", "Line"}], ",", 
                 RowBox[{"2", "\[Rule]", "Polygon"}], ",", 
                 RowBox[{"3", "\[Rule]", "Tetrahedron"}]}], "}"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"MinMax", "[", "e", "]"}], "===", 
                RowBox[{"{", 
                 RowBox[{"1", ",", 
                  RowBox[{"Length", "[", "p", "]"}]}], "}"}]}], ",", 
               "\[IndentingNewLine]", 
               RowBox[{"MeshRegion", "[", 
                RowBox[{"p", ",", 
                 RowBox[{"d", "[", "e", "]"}]}], "]"}]}], "]"}]}]}], "]"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DisplayMeshRegions", " ", "=", " ", 
     RowBox[{
      RowBox[{"(", "\[IndentingNewLine]", 
       RowBox[{"Graphics3D", "@@", 
        RowBox[{"Prepend", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Join", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{"{", "##", "}"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Head", "[", "#", "]"}], "===", "Rule"}], ")"}], 
               "&"}]}], "]"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Axes", "\[Rule]", "True"}], ",", "\[IndentingNewLine]", 
              RowBox[{"AxesLabel", "\[Rule]", 
               RowBox[{"{", 
                RowBox[{"\"\<X\>\"", ",", "\"\<Y\>\"", ",", "\"\<Z\>\""}], 
                "}"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{"Boxed", "\[Rule]", "True"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"LabelStyle", "\[Rule]", "MyTS"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"PlotRange", "\[Rule]", "All"}]}], "}"}]}], "]"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"Select", "[", 
            RowBox[{
             RowBox[{"{", "##", "}"}], ",", 
             RowBox[{
              RowBox[{"Not", "[", 
               RowBox[{
                RowBox[{"Head", "[", "#", "]"}], "===", "Rule"}], "]"}], 
              "&"}]}], "]"}], "/.", 
           RowBox[{"x_", "\[RuleDelayed]", 
            RowBox[{
             RowBox[{"GraphicsComplex", "[", 
              RowBox[{
               RowBox[{"MeshCoordinates", "[", "x", "]"}], ",", 
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"EdgeForm", "[", "None", "]"}], ",", 
                 RowBox[{"MeshCells", "[", 
                  RowBox[{"x", ",", "2"}], "]"}]}], "}"}]}], "]"}], "/;", 
             RowBox[{"MemberQ", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"BoundaryMeshRegion", ",", "MeshRegion"}], "}"}], ",", 
               RowBox[{"Head", "[", "x", "]"}]}], "]"}]}]}]}]}], "]"}]}], 
       "\[IndentingNewLine]", ")"}], "&"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", "\[IndentingNewLine]"}]}]], "Input",
