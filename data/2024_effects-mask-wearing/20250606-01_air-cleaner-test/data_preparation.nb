Cell[BoxData[{
 RowBox[{
  RowBox[{"dtesto", "=", 
   RowBox[{"Import", "[", 
    RowBox[{
     RowBox[{
     "urlHead", " ", "~~", "\"\<testo435%202025-06-20%2014-35.csv\>\""}], 
     ",", "\"\<Text\>\""}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dtesto", "=", 
   RowBox[{"myStringSplit", "[", 
    RowBox[{
     RowBox[{"StringReplace", "[", 
      RowBox[{"dtesto", ",", 
       RowBox[{"\"\<,\>\"", "->", "\"\<.\>\""}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<\\n\>\"", ",", "\"\<;\>\""}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dtestoVarNames", "=", 
   RowBox[{
    RowBox[{"dtesto", "[", 
     RowBox[{"[", "1", "]"}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"4", ";;", 
      RowBox[{"-", "1"}]}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dtesto", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"UnixTime", "[", 
          RowBox[{"FromDateString", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "~~", " ", "\"\< \>\"", " ", "~~",
             " ", 
            RowBox[{"#", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], "]"}], "]"}], ",", 
         RowBox[{"ToExpression", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"4", ";;", 
             RowBox[{"-", "1"}]}], "]"}], "]"}], "]"}]}], "}"}], "]"}], "&"}],
      "/@", 
     RowBox[{"dtesto", "[", 
      RowBox[{"[", 
       RowBox[{"2", ";;", 
        RowBox[{"-", "2"}]}], "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Device", " ", "specification", " ", 
    TemplateBox[{"testo435", {
       URL[
       "https://static.testo.com/image/upload/HQ/testo-435-data-sheet.pdf"], 
       None}, "https://static.testo.com/image/upload/HQ/testo-435-data-sheet.\
pdf", "HyperlinkActionRecycled", {"HyperlinkActive"}, 
      BaseStyle -> {"Hyperlink"}, HyperlinkAction -> "Recycled"},
     "HyperlinkTemplate"]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{"testoCO2", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"testoCO2", "[", "v_Real", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "}"}], ",", 
