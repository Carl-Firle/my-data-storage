            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"{", 
              
              RowBox[{"\"\<load_start\>\"", ",", "\"\<load_total\>\"", 
               ",", "\"\<measurement_end\>\""}], "}"}]}], "]"}], "&"}]}], 
         "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"search", "=", 
        RowBox[{"Union", "[", 
         RowBox[{
          RowBox[{"Select", "[", 
           RowBox[{"temp", ",", 
            RowBox[{
             RowBox[{"StringContainsQ", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<load_start\>\""}], 
              "]"}], "&"}]}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"startTimes", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"Position", "[", 
              RowBox[{"temp", ",", "#"}], "]"}], "&"}], "/@", "search"}], 
           ")"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], "]"}]}], 
       "\[IndentingNewLine]", ";", 
       RowBox[{"endTimes", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Position", "[", 
           RowBox[{"temp", ",", "\"\<measurement_end\>\""}], "]"}], ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
       RowBox[{"periods", "=", 
        RowBox[{"If", "[", 
         RowBox[{
