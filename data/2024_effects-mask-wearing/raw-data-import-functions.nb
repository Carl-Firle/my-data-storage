 RowBox[{
  RowBox[{"loadTimesImport", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "temp", ",", "timepoints", ",", "orderPositions", ",", "search", ",", 
      "startTimes", ",", "endTimes", ",", "periods", ",", "loadValues", ",", 
      "loadTimes", ",", "valueRangePositionList", ",", "newColumn"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<load_start\>\"", ",", "\"\<load_total\>\"", 
              ",", "\"\<measurement_end\>\""}], "}"}]}], "]"}], "&"}]}], 
        "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"search", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"temp", ",", 
           RowBox[{
            RowBox[{"StringContainsQ", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<load_start\>\""}], 
             "]"}], "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"startTimes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"temp", ",", "#"}], "]"}], "&"}], "/@", "search"}], 
          ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"endTimes", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Position", "[", 
          RowBox[{"temp", ",", "\"\<measurement_end\>\""}], "]"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"periods", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "startTimes", "]"}], "==", 
          RowBox[{"Length", "[", "endTimes", "]"}]}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"startTimes", ",", "endTimes"}], "}"}], "]"}], 
         ",", "\"\<load periods are not determined\>\""}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"#1", ";;", "#2"}], "]"}], "]"}], "&"}], "@@@", 
        "periods"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"StringSplit", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<***\>\""}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "&"}], ",", 
           RowBox[{"Partition", "[", 
            RowBox[{"#", ",", "2", ",", "1"}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], "&"}], "/@", "temp"}]}], ";"}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"loadValues", "=", 
      RowBox[{"temp", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "All", ",", "1", ",", "1", ",", "2"}], "]"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"loadTimes", "=", 
      RowBox[{"Map", "[", 
       RowBox[{"positionInTimeline", ",", 
        RowBox[{"temp", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "All", ",", "All", ",", "2"}], "]"}], "]"}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"valueRangePositionList", "=", 
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"loadValues", ",", "loadTimes"}], "}"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"Table", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"Length", "[", 
         RowBox[{"oneTable", "[", 
          RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"newColumn", "[", 
          RowBox[{"[", 
           RowBox[{
            RowBox[{"#2", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ";;", 
            RowBox[{"#2", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "=", 
         RowBox[{"Table", "[", 
          RowBox[{"#1", ",", 
