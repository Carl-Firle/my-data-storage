     RowBox[{"{", 
      RowBox[{"temp", ",", "timepoints", ",", "orderPositions"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"temp", "=", 
