            RowBox[{"[", 
             RowBox[{"All", ",", "timePosition"}], "]"}], "]"}]}], "]"}]}], 
        "\[IndentingNewLine]", ",", "True", "\[IndentingNewLine]", ",", 
        "Nothing"}], "]"}], ";", "\[IndentingNewLine]", "l2"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
