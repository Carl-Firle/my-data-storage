Cell[BoxData[{
 RowBox[{"spiroTimeDeltaCorrection", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spiroTimeDeltaCorrection", "[", "list_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"diff", ",", "lasttime", ",", "temp", ",", "tempAll"}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"lasttime", "=", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", 
              RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"diff", "=", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "-", "lasttime"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"temp", "=", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", "All", ",", "1"}], "]"}], "]"}], "+", 
            "diff"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"tempAll", "=", "#"}], ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"tempAll", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "All", ",", "1"}], "]"}], "]"}], "=", "temp"}],
           ";", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"-", "1"}], "]"}], "]"}], "->", 
           RowBox[{"tempAll", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}]}], "\[IndentingNewLine]", ")"}], 
        "&"}], "\[IndentingNewLine]", ",", "list"}], "\[IndentingNewLine]", 
      "]"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spiroDataTimeCalibrated", "=", 
   RowBox[{"spiroTimeDeltaCorrection", "[", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"times", "[", 
         RowBox[{"[", "parts", "]"}], "]"}], "[", 
        RowBox[{"[", 
