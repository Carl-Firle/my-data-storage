Cell[BoxData[
 RowBox[{"(*", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
   "The", " ", "synchronization", " ", "offset", " ", "between", " ", 
    "breathing", " ", "volume", " ", "and", " ", "the", " ", "two", " ", 
    "dynamometer", " ", "signals", " ", "was", " ", "assessed", " ", "using", 
    " ", "the", " ", "time", " ", "difference", " ", "between", " ", 
    "corresponding", " ", 
    RowBox[{"maxima", ".", "The"}], " ", "median", " ", "offsets", " ", 
    "were", " ", "0.5", " ", "s", " ", "for", " ", "dynamometer", " ", "1", " ",
     "and", " ", "1.5", " ", "s", " ", "for", " ", "dynamometer", " ", "2.", 
    "\n", "\[IndentingNewLine]", "Linear", " ", "regression", " ", "of", " ", 
    "the", " ", "offset", " ", "against", " ", "elapsed", " ", "measurement", 
    " ", "time", " ", "showed", " ", "no", " ", "relevant", " ", "drift", " ",
     "for", " ", "dynamometer", " ", "1", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"R\.b2", "=", "0.007"}], ",", 
      RowBox[{"p", "=", "0.617"}]}], ")"}], " ", "and", " ", "only", " ", "a",
     " ", "weak"}], ",", 
   RowBox[{
   "borderline", " ", "trend", " ", "for", " ", "dynamometer", " ", "2", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"R\.b2", "=", "0.099"}], ",", 
       RowBox[{"p", "=", "0.051"}]}], ")"}], ".", "The"}], " ", "estimated", " ",
     "change", " ", "over", " ", "the", " ", "measurement", " ", "period", " ",
     "remained", " ", "below", " ", "one", " ", "sampling", " ", "interval", " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"0.5", " ", "s"}], ")"}], ".", "Therefore"}]}], ",", 
   RowBox[{
