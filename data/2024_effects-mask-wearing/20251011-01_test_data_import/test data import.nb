           RowBox[{"#", "[", 
            RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<***\>\""}], "]"}], "->", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", "temp"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"tempEnd", "=", 
