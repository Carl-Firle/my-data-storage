 RowBox[{
  RowBox[{"newtonFromRIPripcage", "[", "v_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "}"}], ",", 
    RowBox[{"Around", "[", 
     RowBox[{
      RowBox[{"lnmRipCageGetForce", "[", "v", "]"}], ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Subtract", "@@", 
         RowBox[{"Reverse", "@", 
          RowBox[{"(", 
