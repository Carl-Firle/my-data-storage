       RowBox[{"lnm", "[", 
        RowBox[{"{", "\"\<ParameterEstimates\>\"", "}"}], "]"}], 
       "\[IndentingNewLine]", ",", 
       RowBox[{"stats", "[", "lnm", "]"}], "\[IndentingNewLine]", "\n", ",", 
