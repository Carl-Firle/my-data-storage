            RowBox[{"FromDateString", "[", 
             RowBox[{
              RowBox[{"StringReplace", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"#", "[", 
                  RowBox[{"[", "1", "]"}], "]"}], "~~", " ", "\"\< \>\"", " ",
                  "~~", " ", 
                 RowBox[{"#", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                RowBox[{"\"\<\\\"\>\"", "->", "\"\<\>\""}]}], "]"}], ",", 
              RowBox[{"{", 
               
               RowBox[{"\"\<Day\>\"", ",", "\"\<Month\>\"", 
                ",", "\"\<Year\>\"", ",", "\"\<Time\>\""}], "}"}]}], "]"}], 
            "]"}], ",", 
           RowBox[{"ToExpression", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"StringReplace", "[", 
               RowBox[{"#", ",", 
                RowBox[{"\"\<,\>\"", "->", "\"\<.\>\""}]}], "]"}], "&"}], "/@", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"3", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "]"}]}], "}"}], "]"}], 
        "&"}], "/@", 
       RowBox[{"dMS30", "[", 
        RowBox[{"[", 
         RowBox[{"9", ";;", 
          RowBox[{"-", "1"}]}], "]"}], "]"}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"dMS30sync", "=", 
      RowBox[{"synchronize", "[", 
       RowBox[{"dMS30", ",", "1", ",", "deviceName"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"oneTable", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"dMS30sync", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newColumn", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"positionInTimeline", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "&"}], "/@", 
           "dMS30sync"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "!=", "\"\<NotFound\>\""}], 
           "&"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTable", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oneTable", ",", 
          RowBox[{"Transpose", "[", "newColumn", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", "varNamesMS30"}], "]"}], "\[IndentingNewLine]",
      ";"}]}], "\[IndentingNewLine]", "]"}]}]}], "Input",
