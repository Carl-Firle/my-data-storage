   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"created", " ", "with", " ", "GPT"}], "-", 
     RowBox[{"5.6", " ", "Sol", " ", "start"}]}], " ", "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "findDynMinMaxMin", "]"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{
    RowBox[{"findDynMinMaxMin", "[", 
     RowBox[{"t_Tabular", ",", "vMax_", ",", "offsets_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"time", ",", "columns", ",", "findOne"}], "}"}], 
      "\[IndentingNewLine]", ",", 
      RowBox[{
       RowBox[{"time", "=", 
        RowBox[{"Normal", "[", 
         RowBox[{"t", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"columns", "=", 
        RowBox[{"{", 
         RowBox[{"\"\<dynamometer_1 force [N]\>\"", 
          ",", "\"\<dynamometer_2 force [N]\>\""}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"findOne", "[", "column_", "]"}], ":=", 
        RowBox[{"Module", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
           "values", ",", "timeDyn", ",", "posVMax", ",", "posMin1", ",", 
            "posMax", ",", "posMin2"}], "}"}], "\[IndentingNewLine]", ",", 
          RowBox[{
           RowBox[{"values", "=", 
            RowBox[{"Normal", "[", 
             RowBox[{"t", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "column"}], "]"}], "]"}], "]"}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{"Apply", " ", "synchronization", " ", "offset"}], "*)"}], 
           "\[IndentingNewLine]", 
           RowBox[{"timeDyn", "=", 
            RowBox[{"time", "-", 
             RowBox[{"offsets", "[", "column", "]"}]}]}], ";", 
           "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Find", " ", "position", " ", "of", " ", "volume", " ", "maximum",
              " ", "on", " ", "corrected", " ", "time", " ", "axis"}], "*)"}],
            "\[IndentingNewLine]", 
           RowBox[{"posVMax", "=", 
            RowBox[{"First", "@", 
             RowBox[{"Ordering", "[", 
              RowBox[{
               RowBox[{"Abs", "[", 
                RowBox[{"timeDyn", "-", "vMax"}], "]"}], ",", "1"}], 
              "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Find", " ", "minimum", " ", "before", " ", "the", " ", "volume", 
             " ", "maximum"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"posMin1", "=", 
            RowBox[{"First", "@", 
             RowBox[{"Ordering", "[", 
              RowBox[{
               RowBox[{"values", "[", 
                RowBox[{"[", 
                 RowBox[{"1", ";;", "posVMax"}], "]"}], "]"}], ",", "1"}], 
              "]"}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Find", " ", "maximum", " ", "after", " ", "the", " ", "first", " ",
              "minimum"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"posMax", "=", 
            RowBox[{"posMin1", "-", "1", "+", 
             RowBox[{"First", "@", 
              RowBox[{"Ordering", "[", 
               RowBox[{
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"posMin1", ";;"}], "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}]}]}], ";", "\[IndentingNewLine]",
            "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Find", " ", "minimum", " ", "after", " ", "the", " ", 
             "maximum"}], "*)"}], "\[IndentingNewLine]", 
           RowBox[{"posMin2", "=", 
            RowBox[{"posMax", "-", "1", "+", 
             RowBox[{"First", "@", 
              RowBox[{"Ordering", "[", 
               RowBox[{
                RowBox[{"values", "[", 
                 RowBox[{"[", 
                  RowBox[{"posMax", ";;"}], "]"}], "]"}], ",", "1"}], 
               "]"}]}]}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
           RowBox[{"(*", 
            RowBox[{
            "Return", " ", "corrected", " ", "time", " ", "and", " ", 
             "value"}], "*)"}], 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"timeDyn", "[", 
                RowBox[{"[", "posMin1", "]"}], "]"}], ",", 
               RowBox[{"values", "[", 
                RowBox[{"[", "posMin1", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"timeDyn", "[", 
                RowBox[{"[", "posMax", "]"}], "]"}], ",", 
               RowBox[{"values", "[", 
                RowBox[{"[", "posMax", "]"}], "]"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"timeDyn", "[", 
                RowBox[{"[", "posMin2", "]"}], "]"}], ",", 
               RowBox[{"values", "[", 
                RowBox[{"[", "posMin2", "]"}], "]"}]}], "}"}]}], "}"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"AssociationMap", "[", 
        RowBox[{"findOne", ",", "columns"}], "]"}]}]}], "\[IndentingNewLine]",
      "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"ClearAll", "[", "calculateBreathDifferences", "]"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"calculateBreathDifferences", "[", 
      RowBox[{"data", ":", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"_", ",", "_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"_", ",", "_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"_", ",", "_"}], "}"}]}], "}"}], ".."}], "}"}]}], "]"}], "/;", 
     RowBox[{
      RowBox[{"Length", "[", "data", "]"}], "==", "3"}]}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"volume", ",", "dyn1", ",", "dyn2", ",", "differences"}], 
       "}"}], "\[IndentingNewLine]", ",", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"volume", ",", "dyn1", ",", "dyn2"}], "}"}], "=", "data"}], ";",
        "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"differences", "[", 
         RowBox[{"d_", ",", 
          RowBox[{"valueFactor_", ":", "1"}]}], "]"}], ":=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}], "-", 
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"valueFactor", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"1", ",", "2"}], "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "1"}], "]"}], "]"}], "-", 
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"2", ",", "1"}], "]"}], "]"}]}], ",", 
          RowBox[{"valueFactor", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "2"}], "]"}], "]"}], "-", 
             RowBox[{"d", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ")"}]}], ",", 
          RowBox[{
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"3", ",", "1"}], "]"}], "]"}], "-", 
           RowBox[{"d", "[", 
            RowBox[{"[", 
             RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"Join", "[", 
        RowBox[{
         RowBox[{"differences", "[", 
          RowBox[{"volume", ",", "100"}], "]"}], ",", 
         RowBox[{"differences", "[", "dyn1", "]"}], ",", 
         RowBox[{"differences", "[", "dyn2", "]"}]}], "]"}]}]}], "]"}]}], 
