Cell[BoxData[{
 RowBox[{"doorTimesImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"doorTimesImport", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "temp", ",", "timepoints", ",", "orderPositions", ",", "doorTimes", ",",
        "rangePositions", ",", "newColumn"}], "}"}], ",", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<door\>\""}], "]"}], 
          "&"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{"Append", "[", 
        RowBox[{"temp", ",", 
         RowBox[{"\"\<door_cabin_exit_closed\>\"", "\[Rule]", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"\"\<end of protocol\>\"", " ", "/.", " ", "protocol"}], 
             ")"}], "-", 
            RowBox[{"Quantity", "[", 
             RowBox[{".5", ",", "\"\<Seconds\>\""}], "]"}]}], ")"}]}]}], 
        "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"timepoints", "=", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"temp", ",", 
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<_start\>\"", "->", "\"\<\>\""}], ",", 
              RowBox[{"\"\<_end\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}], 
          "&"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"doorTimes", "=", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"timepoints", ",", 
         RowBox[{
          RowBox[{"StringReplace", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\"\<_open\>\"", "->", "\"\<\>\""}], ",", 
              RowBox[{"\"\<_closed\>\"", "->", "\"\<\>\""}]}], "}"}]}], "]"}],
           "&"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"timepoints", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"Equal", "@@", 
            RowBox[{"(", 
             RowBox[{"Length", "/@", "#"}], ")"}]}], ",", 
           RowBox[{"Transpose", "[", "#", "]"}], ",", "#"}], "]"}], "&"}], "/@",
         "doorTimes"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"rangePositions", "=", 
       RowBox[{"Map", "[", 
