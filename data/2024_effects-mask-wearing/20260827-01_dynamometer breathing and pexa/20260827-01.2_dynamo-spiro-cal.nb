Cell[BoxData[{
 RowBox[{"stats", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"stats", "[", "fit_FittedModel", "]"}], ":=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<R\.b2\>\"", "->", 
      RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}]}], ",", 
     RowBox[{"\"\<adjusted R\.b2\>\"", "->", 
      RowBox[{"fit", "[", "\"\<AdjustedRSquared\>\"", "]"}]}], ",", 
     RowBox[{"\"\<r\>\"", "->", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"fit", "[", "\"\<RSquared\>\"", "]"}], "]"}]}], ",", 
     RowBox[{"\"\<AIC\>\"", "->", 
      RowBox[{"fit", "[", "\"\<AIC\>\"", "]"}]}], ",", 
     RowBox[{"\"\<MAE\>\"", "->", 
      RowBox[{"Mean", "[", 
       RowBox[{"Abs", "[", 
        RowBox[{"fit", "[", "\"\<FitResiduals\>\"", "]"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<RMSE\>\"", "->", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"Mean", "[", 
        RowBox[{
         RowBox[{"fit", "[", "\"\<FitResiduals\>\"", "]"}], "^", "2"}], "]"}],
        "]"}]}]}], "|>"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"bands95", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bands95", "[", 
     RowBox[{"l_", ",", "x_"}], "]"}], ":=", 
    RowBox[{"l", "[", 
     RowBox[{"\"\<MeanPredictionBands\>\"", ",", 
      RowBox[{"ConfidenceLevel", "\[Rule]", ".95"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"lnm", "=."}], "\[IndentingNewLine]", 
 RowBox[{
