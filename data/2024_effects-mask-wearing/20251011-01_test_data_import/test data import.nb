              RowBox[{
               RowBox[{"#2", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ";;", 
               RowBox[{"#2", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}], "]"}], "]"}], "]"}]}], 
          "]"}]}], ")"}], "&"}], "@@@", "valueRangePositionList"}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", "\"\<measurement task\>\""}], "]"}], 
     "\[IndentingNewLine]", ";", 
