           RowBox[{
            RowBox[{"Length", "[", 
             RowBox[{"oneTable", "[", 
              RowBox[{"[", "1", "]"}], "]"}], "]"}], "+", 
            RowBox[{"Length", "[", "varNamesList", "]"}]}]}], "}"}], ",", 
         RowBox[{"{", 
