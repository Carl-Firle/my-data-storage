Cell[BoxData[{
 RowBox[{
  RowBox[{"values", "=", 
   RowBox[{"dataForAnalysis", "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "2", ",", "3"}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peaks", "=", 
   RowBox[{"FindPeaks", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"dataForAnalysis", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "2", ",", "3"}], "]"}], "]"}], "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", "10"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"peaksLow", "=", 
    RowBox[{"FindPeaks", "[", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{
        RowBox[{"dataForAnalysis", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "2", ",", "3"}], "]"}], "]"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ",", "10"}], "]"}]}], 
   ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"peaks", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "<", 
      RowBox[{"peaksLow", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"peaks", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"peaks", ",", "1"}], "]"}]}], ",", "Nothing"}], "]"}], " ", 
   ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "start", " ", "with", " ", "first", " ", "inspiration", " ", "volume"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"peaksLow", "=", 
    RowBox[{"peaksLow", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", 
       RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"peaksLow", "=", 
    RowBox[{"peaksLow", "[", 
     RowBox[{"[", 
      RowBox[{"1", ";;", 
       RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"xdiffs", "=", 
  RowBox[{"Transpose", "[", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"values", "[", 
        RowBox[{"[", 
         RowBox[{"Round", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@", 
      "peaksLow"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"values", "[", 
        RowBox[{"[", 
         RowBox[{"Round", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@", 
      "peaks"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xdiffsLine", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"#", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1"}], "]"}], "]"}], ",", "\[IndentingNewLine]", 
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2"}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"#", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], "&"}], "/@", "xdiffs"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"linesDiff", "=", 
   RowBox[{"Line", "/@", "xdiffsLine"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"xDiffSeconds", "=", 
    RowBox[{"-", 
     RowBox[{"Subtract", "@@@", 
      RowBox[{"xdiffs", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}]}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"inspiratory", " ", "breathing", " ", "duration"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"yDiffVolume", "=", 
    RowBox[{"-", 
     RowBox[{"Subtract", "@@@", 
      RowBox[{"xdiffs", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}]}]}], " ", ";"}], 
  RowBox[{"(*", 
   RowBox[{"inspiratory", " ", "breathing", " ", "volume"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Tabular", "[", 
   RowBox[{
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"xDiffSeconds", ",", "yDiffVolume"}], "}"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"\"\<\[CapitalDelta] insp. time [s]\>\"", 
      ",", "\"\<\[CapitalDelta] insp. volume [l]\>\""}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Show", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"values", ",", 
        RowBox[{
         RowBox[{
          RowBox[{"values", "[", 
           RowBox[{"[", 
            RowBox[{"Round", "@", "#"}], "]"}], "]"}], "&"}], "/@", " ", 
         RowBox[{"peaks", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"values", "[", 
           RowBox[{"[", 
            RowBox[{"Round", "@", "#"}], "]"}], "]"}], "&"}], "/@", " ", 
         RowBox[{"peaksLow", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}]}]}], "}"}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"Joined", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"True", ",", "False", ",", "False"}], "}"}]}], ",", 
      "\[IndentingNewLine]", 
      RowBox[{"PlotStyle", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"Automatic", ",", 
         RowBox[{"PointSize", "[", ".02", "]"}], ",", 
         RowBox[{"PointSize", "[", ".02", "]"}], ",", 
         RowBox[{"PlotRange", "->", "All"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"Graphics", "[", 
       RowBox[{"{", 
        RowBox[{"Thick", ",", "Red", ",", "#"}], "}"}], "]"}], "&"}], "/@", 
     "linesDiff"}]}], "\[IndentingNewLine]", "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]"}], "Input",
