Cell[TextData[StyleBox["breaths from spirometry", "Subsubsection"]], "Text",
 CellChangeTimes->{{3.955546813045561*^9, 
  3.9555468171330585`*^9}},ExpressionUUID->"7edadeab-6806-f54e-87a5-\
76cf723bfff9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"breathDetect", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"breathDetect", "[", "l_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "peaks", ",", "peaksLow", ",", "xdiffs", ",", "linesDiff", ",", 
       "xDiffSeconds", ",", "yDiffVolume"}], "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"values", "=", 
       RowBox[{"l", "[", 
        RowBox[{"[", 
         RowBox[{"2", ",", "3"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"peaks", "=", 
       RowBox[{"FindPeaks", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"l", "[", 
           RowBox[{"[", 
            RowBox[{"2", ",", "3"}], "]"}], "]"}], "[", 
          RowBox[{"[", 
