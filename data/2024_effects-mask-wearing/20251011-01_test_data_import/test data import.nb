Cell[BoxData[
 TemplateBox[{
  "NIntegrate", "ncvb", 
   "\"NIntegrate failed to converge to prescribed accuracy after \
\\!\\(\\*RowBox[{\\\"9\\\"}]\\) recursive bisections in \
\\!\\(\\*RowBox[{\\\"x\\\"}]\\) near \\!\\(\\*RowBox[{\\\"{\\\", \\\"x\\\", \
\\\"}\\\"}]\\) = \\!\\(\\*RowBox[{\\\"{\\\", \\\"29.586020418169387`\\\", \
\\\"}\\\"}]\\). NIntegrate obtained \\!\\(\\*RowBox[{\\\"815.2090731875654`\\\
\"}]\\) and \\!\\(\\*RowBox[{\\\"0.011908928375541208`\\\"}]\\) for the \
integral and error estimates.\"", 2, 241, 68, 30665162891854070327, "Local"},
  "MessageTemplate",
