Cell[BoxData[
 RowBox[{"newColumn", "=", 
  RowBox[{"ReplacePart", "[", 
   RowBox[{"newColumn", ",", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"positionInTimeline", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
         RowBox[{"#", "[", 
