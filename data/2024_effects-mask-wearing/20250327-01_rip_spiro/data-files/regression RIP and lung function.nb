Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"preparePNGData", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"preparePNGData", "[", "pngPath_String", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "points", ",", "pxPosition0And1Y", ",", "pxPosition0And2X", ",", 
       "pxDistanceFor1Liter", ",", "pxDistanceFor1S"}], "}"}], 
     "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"points", "=", 
       RowBox[{"PixelValuePositions", "[", 
        RowBox[{
         RowBox[{"Import", "[", "pngPath", "]"}], ",", "Blue", ",", ".25"}], 
        "]"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{"get", " ", "blue", " ", "pixle", " ", "points"}], "*)"}], 
      "\n", "\[IndentingNewLine]", 
      RowBox[{"pxPosition0And1Y", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"85", ",", "203"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"84", ",", "144"}], "}"}]}], "}"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "manually", " ", "detected", " ", "0", " ", "and", " ", "1", " ", 
         "y"}], "-", "values"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pxPosition0And2X", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"859", ",", "145"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"799", ",", "145"}], "}"}]}], "}"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "manually", " ", "detected", " ", "0", " ", "and", " ", "2", " ", 
         "x"}], "-", "values"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pxDistanceFor1Liter", "=", 
       RowBox[{"Subtract", "@@", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"pxPosition0And1Y", "\[Transpose]"}], "[", 
          RowBox[{"[", "2", "]"}], "]"}], ")"}]}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "factor", " ", "for", " ", "volume", " ", "scaling", " ", "insted", " ",
         "of", " ", "pixles"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"pxDistanceFor1S", "=", 
       RowBox[{
        RowBox[{"Subtract", "@@", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"pxPosition0And2X", "\[Transpose]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], ")"}]}], "/", "2"}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "factor", " ", "for", " ", "volume", " ", "scaling", " ", "insted", " ",
         "of", " ", "pixles"}], "*)"}], "\[IndentingNewLine]", "\n", 
      RowBox[{"points", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"points", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "<", "550"}], "&"}]}], " ", 
        "]"}]}], " ", ";", 
      RowBox[{"(*", 
       RowBox[{
       "cut", " ", "top", " ", "right", " ", "curve", " ", "description"}], 
       "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"points", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"points", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "2"}], "]"}], "]"}], "/", 
         "pxDistanceFor1Liter"}], " ", "1."}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "replace", " ", "y", " ", "pixles", " ", "values", " ", "by", " ", 
        "volumes", " ", "values"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"points", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{"points", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "1"}], "]"}], "]"}], "/", "pxDistanceFor1S"}], 
        " ", "1."}]}], ";", " ", 
      RowBox[{"(*", 
       RowBox[{
       "replace", " ", "x", " ", "pixles", " ", "values", " ", "by", " ", 
        "second", " ", "values"}], "*)"}], "\[IndentingNewLine]", "\n", 
      RowBox[{"Print", "[", 
       RowBox[{"ListPlot", "[", "points", "]"}], "]"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"SortBy", "[", 
       RowBox[{"points", ",", "First"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"parts", "=", 
  RowBox[{"2", ";;", "9"}]}], "\[IndentingNewLine]", 
 RowBox[{"points", "=", 
  RowBox[{
   RowBox[{
    RowBox[{"preparePNGData", "[", "#", "]"}], "&"}], "/@", 
   RowBox[{"(", 
    RowBox[{"spiroDataPNG", "[", 
     RowBox[{"[", "parts", "]"}], "]"}], ")"}]}]}]}], "Input",
