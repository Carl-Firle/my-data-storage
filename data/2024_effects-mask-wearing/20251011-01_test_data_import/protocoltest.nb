      "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"GatherBy", "[", 
          RowBox[{"#", ",", "First"}], "]"}], "&"}], "/@", 
        "startEndTimes"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"startEndTimes", "=", 
