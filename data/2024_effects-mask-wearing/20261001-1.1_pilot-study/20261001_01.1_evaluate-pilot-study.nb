                   RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", "Dashed"}], 
                  "]"}], ",", 
                 RowBox[{"InfiniteLine", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "loaLower"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "loaLower"}], "}"}]}], "}"}], "]"}], ",", 
                 RowBox[{"InfiniteLine", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "loaUpper"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "loaUpper"}], "}"}]}], "}"}], "]"}], ",", 
                 RowBox[{"Directive", "[", 
                  RowBox[{"Orange", ",", "Thick"}], "]"}], ",", 
                 RowBox[{"InfiniteLine", "[", 
                  RowBox[{"{", 
                   RowBox[{
                    RowBox[{"{", 
                    RowBox[{"0", ",", "bias"}], "}"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"1", ",", "bias"}], "}"}]}], "}"}], "]"}]}], 
