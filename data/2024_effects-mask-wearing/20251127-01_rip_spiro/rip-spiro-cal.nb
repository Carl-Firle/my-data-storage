        "volume"}], "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"peaksLow", "=", 
       RowBox[{"peaksLow", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"peaksLow", "=", 
       RowBox[{"peaksLow", "[", 
        RowBox[{"[", 
         RowBox[{"1", ";;", 
          RowBox[{"Length", "[", "peaks", "]"}]}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"xdiffs", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", 
              RowBox[{"Round", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@",
            "peaksLow"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"values", "[", 
             RowBox[{"[", 
              RowBox[{"Round", "[", 
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "]"}], "&"}], "/@",
            "peaks"}]}], "}"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"linesDiff", "=", 
       RowBox[{"Line", "/@", "xdiffs"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"xDiffSeconds", "=", 
