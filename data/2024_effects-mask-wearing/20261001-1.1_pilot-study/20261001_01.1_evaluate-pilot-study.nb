Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"measuredVolumes", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspVol\>\"", "]"}], "&"}], "/@", 
    "dvalPred"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"predictedVolumes", "=", 
    RowBox[{
     RowBox[{
      RowBox[{"#", "[", "\"\<\[CapitalDelta]VInspPredVol\>\"", "]"}], "&"}], "/@",
      "dvalPred"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"errors", "=", 
   RowBox[{"measuredVolumes", "-", "predictedVolumes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"meanVolumes", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"measuredVolumes", "+", "predictedVolumes"}], ")"}], "/", 
    "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"baData", "=", 
    RowBox[{"Transpose", "[", 
     RowBox[{"{", 
      RowBox[{"meanVolumes", ",", "errors"}], "}"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"bias", "=", 
   RowBox[{"Mean", "[", "errors", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sdErrors", "=", 
    RowBox[{"StandardDeviation", "[", "errors", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"loaLower", "=", 
   RowBox[{"bias", "-", 
    RowBox[{"1.96", " ", "sdErrors"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"loaUpper", "=", 
    RowBox[{"bias", "+", 
     RowBox[{"1.96", " ", "sdErrors"}]}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"<|", 
   RowBox[{
    RowBox[{"\"\<bias [mL]\>\"", "->", "bias"}], ",", 
    RowBox[{"\"\<lower limit of agreement [mL]\>\"", "->", "loaLower"}], ",", 
    RowBox[{"\"\<upper limit of agreement [mL]\>\"", "->", "loaUpper"}]}], 
   "|>"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"baData", ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<mean of measured and predicted volume [mL]\>\"", 
      ",", "\"\<volume difference (measured \[Minus] predicted) [mL]\>\""}], 
     "}"}]}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"Directive", "[", 
     RowBox[{"Blue", ",", 
      RowBox[{"PointSize", "[", "0.016", "]"}]}], "]"}]}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"All", ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Min", "[", 
         RowBox[{"Append", "[", 
          RowBox[{"errors", ",", "loaLower"}], "]"}], "]"}], ",", 
        RowBox[{"Max", "[", 
         RowBox[{"Append", "[", 
          RowBox[{"errors", ",", "loaUpper"}], "]"}], "]"}]}], "}"}]}], 
     "}"}]}], ",", 
   RowBox[{"PlotRangePadding", "->", 
    RowBox[{"Scaled", "[", "0.06", "]"}]}], ",", 
   RowBox[{"Prolog", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"GrayLevel", "[", "0.5", "]"}], ",", "Dashed"}], "]"}], ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "loaLower"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "loaLower"}], "}"}]}], "}"}], "]"}], ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "loaUpper"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "loaUpper"}], "}"}]}], "}"}], "]"}], ",", 
      RowBox[{"Directive", "[", 
       RowBox[{"Orange", ",", "Thick"}], "]"}], ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "bias"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "bias"}], "}"}]}], "}"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"myPlotSequence", "[", "]"}]}], "]"}]}], "Input",
