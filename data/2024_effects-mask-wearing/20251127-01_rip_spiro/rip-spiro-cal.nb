Cell[CellGroupData[{

Cell["synchronization has to be done for every breath", "Subsubsection",
 CellChangeTimes->{{3.993823053642292*^9, 
  3.9938230668990307`*^9}},ExpressionUUID->"42b7181c-1a63-df47-aaa6-\
093de54d68bc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Delta]", "=", 
   RowBox[{"Round", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MaximalBy", "[", 
           RowBox[{"dsel", ",", 
            RowBox[{"#\"RIP_2 force ribcage [N]\"", "&"}], ",", "1"}], "]"}], 
          "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}], "-", 
         RowBox[{
          RowBox[{"MaximalBy", "[", 
           RowBox[{"dsel", ",", 
            RowBox[{"#\"pexa_Inhale Exhale Airflow [ml/s]\"", "&"}], ",", 
            "1"}], "]"}], "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "\"\<elapsed time [s]\>\""}], "]"}], "]"}]}], 
        "]"}], "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}], "*", "2"}], "]"}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dselsync", "=", 
   RowBox[{"TransformColumns", "[", 
    RowBox[{"dsel", ",", 
     RowBox[{"\"\<pexa_Inhale Exhale Airflow [ml/s]\>\"", "->", 
      RowBox[{"Function", "[", 
       RowBox[{"ColumnwiseThread", "[", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Drop", "[", 
           RowBox[{
           "#\"pexa_Inhale Exhale Airflow [ml/s]\"", ",", "\[Delta]"}], "]"}],
           ",", 
          RowBox[{"ConstantArray", "[", 
           RowBox[{
            RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], ",", 
            "\[Delta]"}], "]"}]}], "]"}], "]"}], "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"MaximalBy", "[", 
  RowBox[{"dselsync", ",", 
   RowBox[{"#\"RIP_2 force ribcage [N]\"", "&"}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"MaximalBy", "[", 
