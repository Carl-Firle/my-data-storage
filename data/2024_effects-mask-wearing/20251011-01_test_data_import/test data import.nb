            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"\"\<start\>\"", "->", "\"\<end\>\""}]}], "]"}], "->", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "+", 
            RowBox[{"(", 
             RowBox[{"countdownTime", "=", 
