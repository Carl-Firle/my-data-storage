Cell[BoxData[{
 RowBox[{"createTabular", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"createTabular", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"temp", ",", "varNamesList", ",", "quantities"}], "}"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{
      "s", ",", "L", ",", "l", ",", "ml", ",", "ng", ",", "ug", ",", "cm3", ",",
        "m3", ",", "Watt", ",", "ppm", ",", "mbar", ",", "Celsius", ",", 
       "percent", ",", "n"}], "]"}], "\[IndentingNewLine]", ";", 
     RowBox[{"varNamesList", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"StringReplace", "[", 
         RowBox[{"#", ",", 
          RowBox[{"\"\<[N]\>\"", "->", "\"\<[n]\>\""}]}], "]"}], "&"}], "/@", 
       RowBox[{"Flatten", "[", "varNames", "]"}]}]}], ";", 
     RowBox[{"quantities", "=", 
      RowBox[{
       RowBox[{"ToExpression", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"StringCases", "[", 
            RowBox[{"#", ",", 
             RowBox[{
              RowBox[{"\"\<[\>\"", "~~", "a__", "~~", "\"\<]\>\""}], "->", 
              "a"}]}], "]"}], "&"}], "/@", "varNamesList"}], "]"}], "]"}], 
       " ", "/.", " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"s", "->", "\"\<Seconds\>\""}], ",", 
         RowBox[{"L", "->", "\"\<Liters\>\""}], ",", 
         RowBox[{"l", "->", "\"\<Liters\>\""}], ",", 
         RowBox[{"ml", "->", "\"\<Milliliters\>\""}], ",", 
         RowBox[{"ng", "->", "\"\<nanogram\>\""}], ",", 
         RowBox[{"ug", "->", "\"\<Micrograms\>\""}], ",", 
         RowBox[{"cm3", "->", 
          RowBox[{"(", 
           RowBox[{"\"\<Centimeters\>\"", "^", "3"}], ")"}]}], ",", 
         RowBox[{"m3", "->", 
          RowBox[{"(", 
           RowBox[{"\"\<Meters\>\"", "^", "3"}], ")"}]}], ",", 
         RowBox[{"Watt", "->", "\"\<Watts\>\""}], ",", 
         RowBox[{"ppm", "->", "\"\<PartsPerMillion\>\""}], ",", 
         RowBox[{"mbar", "->", "\"\<Millibars\>\""}], ",", 
         RowBox[{"Celsius", "->", "\"\<DegreesCelsius\>\""}], ",", 
         RowBox[{"percent", "->", "\"\<Percent\>\""}], ",", 
         RowBox[{"n", "->", "\"\<Newtons\>\""}]}], "}"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"temp", "=", 
      RowBox[{"oneTable", "/.", " ", 
       RowBox[{"\"\<n.a.\>\"", "->", 
        RowBox[{"Missing", "[", "]"}]}]}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"temp", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"temp", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "=", 
         RowBox[{
          RowBox[{
           RowBox[{"Quantity", "[", 
            RowBox[{"#", ",", 
             RowBox[{"quantities", "[", 
              RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "&"}], "/@", 
          RowBox[{"temp", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", 
          RowBox[{"Length", "[", "quantities", "]"}]}], "}"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{"oneTableCSV", "=", 
      RowBox[{"Map", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Which", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"Head", "[", "#", "]"}], "===", "Around"}], ",", 
           RowBox[{"myAroundString", "[", "#", "]"}], ",", 
           RowBox[{"NumberQ", "[", "#", "]"}], ",", "#", ",", "True", ",", 
           RowBox[{"StringJoin", "[", "#", "]"}]}], "]"}], "&"}], ",", 
        RowBox[{
         RowBox[{"Transpose", "[", "oneTable", "]"}], "/.", " ", 
         RowBox[{"\"\<n.a.\>\"", "->", "\"\<\>\""}]}], ",", 
        RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTableCSV", "=", 
      RowBox[{"Prepend", "[", 
       RowBox[{"oneTableCSV", ",", 
        RowBox[{"Flatten", "[", "varNames", "]"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"exPath", "~~", "\"\<data_\>\"", "~~", 
        RowBox[{
         RowBox[{"StringSplit", "[", 
          RowBox[{"urlHead", ",", "\"\</\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "~~", "\"\<.csv\>\""}], ",", 
       "oneTableCSV"}], "]"}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTableTab", "=", 
      RowBox[{"ToTabular", "[", 
       RowBox[{
        RowBox[{"Transpose", "[", "temp", "]"}], ",", "\"\<Rows\>\"", ",", 
        RowBox[{"<|", 
         RowBox[{"\"\<ColumnKeys\>\"", "->", 
          RowBox[{"Flatten", "[", "varNames", "]"}]}], "|>"}]}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"Export", "[", 
      RowBox[{
       RowBox[{"exPath", "~~", "\"\<data_\>\"", "~~", 
        RowBox[{
         RowBox[{"StringSplit", "[", 
          RowBox[{"urlHead", ",", "\"\</\>\""}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"-", "1"}], "]"}], "]"}], "~~", "\"\<.m\>\""}], ",", 
       "oneTableTab"}], "]"}]}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
