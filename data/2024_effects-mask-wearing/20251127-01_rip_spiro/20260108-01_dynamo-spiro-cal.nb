 RowBox[{
  RowBox[{"\[Delta]", "=", 
   RowBox[{"Round", "[", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Normal", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"MaximalBy", "[", 
           RowBox[{"dsel", ",", 
            RowBox[{"#\"RIP_2 force ribcage [N]\"", "&"}], ",", "1"}], "]"}], 
          "[", 
