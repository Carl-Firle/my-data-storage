Cell[BoxData[{
 RowBox[{"dDynamometerImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dDynamometerImport", "[", 
   RowBox[{"filename_String", ",", "deviceName_String", ",", 
    RowBox[{"positionForce_Integer", ":", "2"}]}], "]"}], ":=", " ", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "ddynamometer", "}"}], "\[IndentingNewLine]", ",", 
    RowBox[{
     RowBox[{"ddynamometer", "=", 
      RowBox[{"Import", "[", 
       RowBox[{"urlHead", "~~", "filename"}], "]"}]}], "\[IndentingNewLine]", 
     ";", 
     RowBox[{"ddynamometer", "=", 
      RowBox[{"ddynamometer", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "positionForce"}], "}"}]}], "]"}], "]"}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"ddynamometer", " ", "=", 
      RowBox[{"synchronize", "[", 
       RowBox[{
        RowBox[{"Rest", "[", "ddynamometer", "]"}], ",", "1", ",", 
        "deviceName"}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"ddynamometer", " ", "=", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"#", "[", 
           RowBox[{"[", 
            RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
          RowBox[{"Mean", "[", 
           RowBox[{"#", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], "}"}], "&"}], "/@", 
       RowBox[{"GatherBy", "[", 
        RowBox[{"ddynamometer", ",", "First"}], "]"}]}]}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ConstantArray", "[", 
       RowBox[{"\"\<n.a.\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Length", "[", 
           RowBox[{"oneTable", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], ",", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"ddynamometer", "[", 
             RowBox[{"[", 
              RowBox[{"-", "1"}], "]"}], "]"}], "]"}], "-", "1"}]}], "}"}]}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"newColumn", "=", 
      RowBox[{"ReplacePart", "[", 
       RowBox[{"newColumn", ",", 
        RowBox[{"Select", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"positionInTimeline", "[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}], "]"}], "]"}]}], "&"}], "/@", 
           "ddynamometer"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "!=", "\"\<NotFound\>\""}], 
           "&"}]}], "]"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"oneTable", "=", 
      RowBox[{"Flatten", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"oneTable", ",", 
          RowBox[{"Transpose", "[", "newColumn", "]"}]}], "}"}], ",", "1"}], 
       "]"}]}], "\[IndentingNewLine]", ";", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"varNames", ",", 
       RowBox[{"deviceName", "<>", "\"\< force ribcage [N]\>\""}]}], "]"}], 
     "\[IndentingNewLine]", ";"}]}], "\[IndentingNewLine]", 
   "]"}]}], "\[IndentingNewLine]"}], "Input",
