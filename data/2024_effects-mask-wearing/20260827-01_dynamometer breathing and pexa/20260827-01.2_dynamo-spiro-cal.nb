Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"timeFlowData", "=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"myNormalColumnTab", "[", 
         RowBox[{"dExtr", ",", "\"\<elapsed time [s]\>\""}], "]"}], ",", 
        RowBox[{"myNormalColumnTab", "[", 
         RowBox[{"dExtr", ",", "\"\<pexa_Inhale Exhale Airflow [ml/s]\>\""}], 
         "]"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"created", " ", "with", " ", "GPT"}], "-", 
     RowBox[{
     "5.6", " ", "sol", " ", "except", " ", "comments", " ", "_", " ", 
      "start"}]}], "*)"}], "\n", 
   RowBox[{"airflowToVolume", "=."}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"airflowToVolume", "[", "data_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "time", ",", "flow", ",", "deltaT", ",", "deltaV", ",", "volume"}], 
       "}"}], "\[IndentingNewLine]", ",", 
      RowBox[{
       RowBox[{"time", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"flow", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"deltaT", "=", 
        RowBox[{"Differences", "[", "time", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"deltaV", "=", 
        RowBox[{
         RowBox[{"-", "deltaT"}], "*", 
         RowBox[{"MovingAverage", "[", 
          RowBox[{"flow", ",", "2"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"volume", "=", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"Accumulate", "[", "deltaV", "]"}], ",", "0"}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"time", ",", "volume"}], "}"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"volumeData", "=", 
     RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rawVolume", "=", 
     RowBox[{"airflowToVolume", "[", "timeFlowData", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ListLinePlot", "[", 
    RowBox[{"volumeData", ",", 
     RowBox[{"myPlotSequence", "[", "]"}], ",", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}], 
       "}"}]}]}], "]"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "find", " ", "positive", " ", "to", " ", "negative", " ", "sign", " ", 
      "changes", " ", "and", " ", "replace", " ", "with", " ", "averaged", " ",
       "value"}], " ", "=", "  ", 
     RowBox[{
      RowBox[{
      "linear", " ", "interpolation", " ", "of", " ", "the", " ", "exact", " ",
        "zero", " ", "crossing", " ", "at", " ", "the", " ", "end"}], "-", 
      RowBox[{"expiratory", " ", "phase"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"endExpiration", "=", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"Partition", "[", 
        RowBox[{"timeFlowData", ",", "2", ",", "1"}], "]"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t1_", ",", "q1_"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t2_", ",", "q2_"}], "}"}]}], "}"}], "/;", 
         RowBox[{
          RowBox[{"q1", ">", "0"}], "&&", 
          RowBox[{"q2", "<", "0"}]}]}], ":>", 
        RowBox[{"t1", "-", 
         RowBox[{"q1", " ", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"t2", "-", "t1"}], ")"}], "/", 
           RowBox[{"(", 
            RowBox[{"q2", "-", "q1"}], ")"}]}]}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "interpolate", " ", "raw", " ", "volume", " ", "data", " ", "and", " ", 
      "baseline", " ", "points", " ", "from", " ", "end"}], "-", 
     RowBox[{"expiratory", " ", "phase"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"volumeFunction", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"rawVolume", ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"baselinePoints", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"#", ",", 
         RowBox[{"volumeFunction", "[", "#", "]"}]}], "}"}], "&"}], "/@", 
      "endExpiration"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"baseline", "=", 
     RowBox[{"Interpolation", "[", 
      RowBox[{"baselinePoints", ",", 
       RowBox[{"InterpolationOrder", "->", "1"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "correct", " ", "volume", " ", "with", " ", "interpolated", " ", 
      "baseline", " ", "data"}], " ", "->", " ", 
     RowBox[{"v", "-", 
      RowBox[{"baseline", "[", "t", "]"}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"correctedVolume", "=", 
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"rawVolume", ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"First", "[", "baselinePoints", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "<=", 
          RowBox[{
           RowBox[{"Last", "[", "baselinePoints", "]"}], "[", 
           RowBox[{"[", "1", "]"}], "]"}]}], "&"}]}], "]"}], "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t_", ",", "v_"}], "}"}], ":>", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"v", "-", 
          RowBox[{"baseline", "[", "t", "]"}]}]}], "}"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", "plots", "*)"}], "\n", 
   RowBox[{"volumePlot", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{"correctedVolume", ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"myPlotSequence", "[", "]"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}],
         "}"}]}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
   RowBox[{"plotVolumeRawVsCorrected", "=", 
    RowBox[{"ListLinePlot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"rawVolume", ",", "correctedVolume"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}], ",", 
      RowBox[{"myPlotSequence", "[", "]"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{"\"\<elapsed time [s]\>\"", ",", " ", "\"\<volume [ml]\>\""}],
         "}"}]}]}], "]"}]}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"myFigAppend", "[", 
     RowBox[{"{", 
      RowBox[{"plotVolumeRawVsCorrected", ",", "\"\<002\>\"", ",", 
       RowBox[{"\"\<plot interpolated volume baseline corrected vs raw volume \
