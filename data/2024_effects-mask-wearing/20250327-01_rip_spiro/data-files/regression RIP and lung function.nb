  TagBox[GridBox[{
     {
      InterpretationBox[GridBox[{
         {GridBox[{
            {
             RowBox[{
              RowBox[{"myAroundString", "[", 
               RowBox[{"l_List", "/;", 
                RowBox[{
                 RowBox[{
                  RowBox[{"Dimensions", "[", "l", "]"}], "\[LeftDoubleBracket]",
                   "2", "\[RightDoubleBracket]"}], "\[Equal]", "2"}]}], "]"}],
               ":=", 
              RowBox[{"Module", "[", 
               RowBox[{
                RowBox[{"{", "}"}], ",", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"StringJoin", "[", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    "#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}], 
                    "~~", "\<\" \[PlusMinus] \"\>", "~~", 
                    RowBox[{"ToString", "[", 
                    RowBox[{"#1", "\[LeftDoubleBracket]", 
                    RowBox[{"-", "1"}], "\[RightDoubleBracket]"}], "]"}]}], 
                    "]"}], "&"}], ")"}], "/@", "l"}]}], "]"}]}]}
