    RowBox[{
     RowBox[{"dsel", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<pexa_Inhale Exhale Airflow [ml/s]\>\""}], 
       "]"}], "]"}], ",", "2.5"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"peaksLow", "=", 
