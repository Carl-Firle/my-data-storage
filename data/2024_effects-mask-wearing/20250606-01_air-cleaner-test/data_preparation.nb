            RowBox[{"oneTable", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", "1"}], "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}], "&"}], "/@", "lValues"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"replList", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"oneTable", "[", 
           RowBox[{"[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], "->", 
          RowBox[{"Append", "[", 
           RowBox[{
            RowBox[{"oneTable", "[", 
             RowBox[{"[", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "]"}], "]"}], ",", 
            RowBox[{"#", "[", 
             RowBox[{"[", 
              RowBox[{"2", ",", 
               RowBox[{"2", ";;", 
                RowBox[{"-", "1"}]}]}], "]"}], "]"}]}], "]"}]}], "&"}], "/@", 
        RowBox[{"Transpose", "[", 
         RowBox[{"{", 
          RowBox[{"temp", ",", "lValues"}], "}"}], "]"}]}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"temp2", "=", 
       RowBox[{"myFlatten", "[", 
        RowBox[{
         RowBox[{"oneTable", "/.", "replList"}], ",", "1"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"oneTable", "=", 
       RowBox[{"PadRight", "[", 
        RowBox[{"temp2", ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Length", "[", 
            RowBox[{"oneTable", "[", 
