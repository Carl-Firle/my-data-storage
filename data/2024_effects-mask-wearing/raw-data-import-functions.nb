      "\[IndentingNewLine]", ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"oneTable", ",", "newColumn"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"measurementCountdownImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"measurementCountdownImport", "[", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "temp", ",", "tempStart", ",", "tempEnd", ",", "countdownTime", ",", 
       "rangePositions", ",", "newColumn"}], "}"}], "\[IndentingNewLine]", ",", 
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Select", "[", 
        RowBox[{
         StyleBox["protocol",
          FontColor->GrayLevel[0]], ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"{", "\"\<countdown\>\"", "}"}]}], "]"}], "&"}]}], 
        "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"tempStart", "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"StringSplit", "[", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<***\>\""}], "]"}], "->", 
          RowBox[{"#", "[", 
           RowBox[{"[", "2", "]"}], "]"}]}], "&"}], "/@", "temp"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"tempEnd", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"StringReplace", "[", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "1", "]"}], "]"}], ",", 
             RowBox[{"\"\<start\>\"", "->", "\"\<end\>\""}]}], "]"}], "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "+", 
             RowBox[{"(", 
              RowBox[{"countdownTime", "=", 
               RowBox[{"Quantity", "[", 
                RowBox[{
                 RowBox[{"ToExpression", "[", 
                  RowBox[{"#", "[", 
                   RowBox[{"[", 
                    RowBox[{"1", ",", "2"}], "]"}], "]"}], "]"}], 
                 ",", "\"\<Minutes\>\""}], "]"}]}], ")"}]}], ")"}]}], ")"}], 
         "&"}], "/@", "tempStart"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{"Transpose", "[", 
        RowBox[{"{", 
         RowBox[{"tempStart", ",", "tempEnd"}], "}"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"rangePositions", "=", 
       RowBox[{"Map", "[", 
        RowBox[{"positionInTimeline", ",", 
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"All", ",", "All", ",", 
            RowBox[{"-", "1"}]}], "]"}], "]"}], ",", 
         RowBox[{"{", "2", "}"}]}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"newColumn", "=", 
       RowBox[{"Table", "[", 
        RowBox[{"\"\<n.a.\>\"", ",", 
         RowBox[{"Length", "[", 
          RowBox[{"oneTable", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}]}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"newColumn", "[", 
           RowBox[{"[", 
            RowBox[{"#1", ";;", "#2"}], "]"}], "]"}], "=", 
          RowBox[{"Range", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"#2", "-", "#1"}], ")"}], "/", "2"}], ",", "0", ",", 
            RowBox[{"-", ".5"}]}], "]"}]}], ")"}], "&"}], "@@@", 
       "rangePositions"}], "\[IndentingNewLine]", ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"varNames", ",", "\"\<countdown [s]\>\""}], "]"}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"AppendTo", "[", 
       RowBox[{"oneTable", ",", "newColumn"}], "]"}]}]}], 
    "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"loadTimesImport", "=."}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"loadTimesImport", "[", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "temp", ",", "timepoints", ",", "orderPositions", ",", "search", ",", 
      "startTimes", ",", "endTimes", ",", "periods", ",", "loadValues", ",", 
      "loadTimes", ",", "valueRangePositionList", ",", "newColumn"}], "}"}], ",",
     "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"temp", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"protocol", ",", 
         RowBox[{
          RowBox[{"StringContainsQ", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ",", 
            RowBox[{"{", 
             
             RowBox[{"\"\<load_start\>\"", ",", "\"\<load_total\>\"", 
              ",", "\"\<measurement_end\>\""}], "}"}]}], "]"}], "&"}]}], 
        "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"search", "=", 
       RowBox[{"Union", "[", 
        RowBox[{
         RowBox[{"Select", "[", 
          RowBox[{"temp", ",", 
           RowBox[{
            RowBox[{"StringContainsQ", "[", 
             RowBox[{
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<load_start\>\""}], 
             "]"}], "&"}]}], "]"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "1"}], "]"}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"startTimes", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"Position", "[", 
             RowBox[{"temp", ",", "#"}], "]"}], "&"}], "/@", "search"}], 
          ")"}], "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"endTimes", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Position", "[", 
          RowBox[{"temp", ",", "\"\<measurement_end\>\""}], "]"}], ")"}], "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "1"}], "]"}], "]"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"periods", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Length", "[", "startTimes", "]"}], "==", 
          RowBox[{"Length", "[", "endTimes", "]"}]}], ",", 
         RowBox[{"Transpose", "[", 
          RowBox[{"{", 
           RowBox[{"startTimes", ",", "endTimes"}], "}"}], "]"}], 
         ",", "\"\<load periods are not determined\>\""}], "]"}]}], 
      "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"temp", "[", 
          RowBox[{"[", 
           RowBox[{"#1", ";;", "#2"}], "]"}], "]"}], "&"}], "@@@", 
        "periods"}]}], "\[IndentingNewLine]", ";", 
      RowBox[{"temp", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"Map", "[", 
          RowBox[{
           RowBox[{
            RowBox[{
             RowBox[{"StringSplit", "[", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ",", "\"\<***\>\""}], "]"}], "->", 
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}]}], "&"}], ",", 
           RowBox[{"Partition", "[", 
            RowBox[{"#", ",", "2", ",", "1"}], "]"}], ",", 
           RowBox[{"{", "2", "}"}]}], "]"}], "&"}], "/@", "temp"}]}], ";"}], 
     "\[IndentingNewLine]", ";", 
     RowBox[{"loadValues", "=", 
