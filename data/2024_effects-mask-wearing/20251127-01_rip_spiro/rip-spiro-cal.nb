      RowBox[{"peaksLow", "[", 
       RowBox[{"[", 
        RowBox[{"1", ",", "1"}], "]"}], "]"}]}], ",", 
     RowBox[{"peaks", "=", 
      RowBox[{"Delete", "[", 
       RowBox[{"peaks", ",", "1"}], "]"}]}], ",", "Nothing"}], "]"}], ";"}], 
